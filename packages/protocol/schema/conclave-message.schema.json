        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "taskId",
            "repositoryId",
            "revision",
            "path"
          ],
          "properties": {
            "operation": { "const": "delete_file" },
            "taskId": { "$ref": "#/$defs/id" },
