{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conclaveax.com/schemas/conclave-message.schema.json",
  "title": "Conclave canonical message",
  "description": "Current cross-language product, Workspace message metadata, execution error, and realtime event contracts.",
  "x-protocol-version": "0.1",
  "x-execution-error-codes": [
    "worker_not_ready",
    "cli_not_found",
    "authentication_required",
    "unsupported_cli_version",
    "model_not_supported",
    "permission_denied",
    "quota_exhausted",
    "provider_unavailable",
    "timeout",
    "cancelled",
    "internal_adapter_error",
    "execution_failed"
  ],
  "x-execution-error-messages": {
    "worker_not_ready": "The selected Worker is not ready on its Workspace.",
    "cli_not_found": "The required local CLI could not be found.",
    "authentication_required": "Sign in to the configured provider on this computer.",
    "unsupported_cli_version": "The installed local CLI version is not supported.",
    "model_not_supported": "The selected model is not supported by this Worker.",
    "permission_denied": "A local permission required for this assignment was denied.",
    "quota_exhausted": "The provider's usage limit has been reached.",
    "provider_unavailable": "The provider is temporarily unavailable.",
    "timeout": "The assignment exceeded its time limit.",
    "cancelled": "The assignment was cancelled.",
    "internal_adapter_error": "The local Worker integration needs attention.",
    "execution_failed": "The assignment could not be completed."
  },
  "x-host-protocol": {
    "name": "conclave.host-protocol",
    "version": "4.0",
    "maxMessageSizeBytes": 4194304,
    "messageTypes": [
      "host.hello",
      "host.hello.ack",
      "host.heartbeat",
      "host.heartbeat.ack",
      "host.sync.request",
      "host.sync.result",
      "host.status",
      "host.update",
      "assignment.start",
      "assignment.ack",
      "assignment.progress",
      "assignment.result",
      "assignment.error",
      "assignment.cancel",
      "assignment.cancel.ack"
    ],
    "baseEnvelopeFields": [
      "protocol",
      "protocolVersion",
      "messageId",
      "correlationId",
      "timestamp",
      "type",
      "payload"
    ],
    "assignmentEnvelopeFields": [
      "workspaceId",
      "hostId",
      "workerId",
      "runId",
      "taskId",
      "attemptId",
      "assignmentId",
      "idempotencyKey"
    ],
    "payloadSchemas": {
      "host.hello": "#/$defs/hostHelloPayload",
      "host.hello.ack": "#/$defs/hostHelloAckPayload",
      "host.heartbeat": "#/$defs/hostHeartbeatPayload",
      "host.heartbeat.ack": "#/$defs/hostHeartbeatAckPayload",
      "host.sync.request": "#/$defs/hostSyncRequestPayload",
      "host.sync.result": "#/$defs/hostSyncResultPayload",
      "host.status": "#/$defs/hostStatusPayload",
      "host.update": "#/$defs/hostUpdatePayload",
      "assignment.start": "#/$defs/assignmentStartPayload",
      "assignment.ack": "#/$defs/assignmentAckPayload",
      "assignment.progress": "#/$defs/assignmentProgressPayload",
      "assignment.result": "#/$defs/assignmentResultPayload",
      "assignment.error": "#/$defs/assignmentErrorPayload",
      "assignment.cancel": "#/$defs/assignmentCancelPayload",
      "assignment.cancel.ack": "#/$defs/assignmentCancelAckPayload"
    }
  },
  "x-realtime-events": {
    "name": "conclave.realtime-events",
    "version": "1.0",
    "envelopeFields": [
      "eventId",
      "type",
      "version",
      "timestamp",
      "workspaceId",
      "sequence",
      "payload"
    ],
    "optionalEnvelopeFields": [
      "projectId",
      "chatId",
      "runId",
      "taskId",
      "attemptId",
      "assignmentId",
      "hostId"
    ],
    "durableTypes": [
      "chat.message.created",
      "work_request.created",
      "work_request.started",
      "work_request.completed",
      "work_request.failed",
      "work_request.cancelled",
      "step.queued",
      "step.running",
      "step.completed",
      "step.failed",
      "step.cancelled",
      "run.started",
      "run.paused",
      "run.resumed",
      "run.completed",
      "run.failed",
      "task.started",
      "task.completed",
      "task.failed",
      "attempt.started",
      "attempt.completed",
      "attempt.failed",
      "assignment.accepted",
      "assignment.completed",
      "assignment.failed",
      "assignment.cancelled",
      "artifact.created",
      "finding.created",
      "finding.resolved",
      "verification.completed",
      "host.enrolled",
      "host.revoked",
      "account.sharing.changed"
    ],
    "ephemeralTypes": [
      "assignment.progress",
      "worker.status",
      "stream.delta",
      "tool.invocation.status",
      "typing",
      "heartbeat",
      "host.load"
    ],
    "payloadSchema": "#/$defs/realtimeEventPayload"
  },
  "x-message-types": [
    "PlanRequest",
    "PlanResult",
    "TaskRequest",
    "TaskResult",
    "ResearchResult",
    "ImplementationResult",
    "ReviewResult",
    "TestResult",
    "VerificationResult",
    "DecisionResult",
    "CompletionResult",
    "RuntimeOperationRequest"
  ],
  "x-message-payloads": {
    "PlanRequest": "#/$defs/planRequestPayload",
    "PlanResult": "#/$defs/planResultPayload",
    "TaskRequest": "#/$defs/taskRequestPayload",
    "TaskResult": "#/$defs/taskResultPayload",
    "ResearchResult": "#/$defs/researchResultPayload",
    "ImplementationResult": "#/$defs/implementationResultPayload",
    "ReviewResult": "#/$defs/reviewResultPayload",
    "TestResult": "#/$defs/testResultPayload",
    "VerificationResult": "#/$defs/verificationResultPayload",
    "DecisionResult": "#/$defs/decisionResultPayload",
    "CompletionResult": "#/$defs/completionResultPayload",
    "RuntimeOperationRequest": "#/$defs/runtimeOperationPayload"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "messageId",
    "goalId",
    "runId",
    "workerId",
    "createdAt",
    "messageType",
    "payload"
  ],
  "properties": {
    "protocol": {
      "const": "conclave.protocol"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "messageId": {
      "$ref": "#/$defs/id"
    },
    "goalId": {
      "$ref": "#/$defs/id"
    },
    "runId": {
      "$ref": "#/$defs/id"
    },
    "workerId": {
      "$ref": "#/$defs/id"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "messageType": {
      "type": "string",
      "enum": [
        "PlanRequest",
        "PlanResult",
        "TaskRequest",
        "TaskResult",
        "ResearchResult",
        "ImplementationResult",
        "ReviewResult",
        "TestResult",
        "VerificationResult",
        "DecisionResult",
        "CompletionResult",
        "RuntimeOperationRequest"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "PlanRequest"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/planRequestPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "PlanResult"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/planResultPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "TaskRequest"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/taskRequestPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "TaskResult"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/taskResultPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "ResearchResult"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/researchResultPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "ImplementationResult"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/implementationResultPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "ReviewResult"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/reviewResultPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "TestResult"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/testResultPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "VerificationResult"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/verificationResultPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "DecisionResult"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/decisionResultPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "CompletionResult"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/completionResultPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "RuntimeOperationRequest"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/runtimeOperationPayload"
          }
        }
      }
    }
  ],
  "$defs": {
    "executionErrorCode": {
      "type": "string",
      "enum": [
        "worker_not_ready",
        "cli_not_found",
        "authentication_required",
        "unsupported_cli_version",
        "model_not_supported",
        "permission_denied",
        "quota_exhausted",
        "provider_unavailable",
        "timeout",
        "cancelled",
        "internal_adapter_error",
        "execution_failed"
      ]
    },
    "executionError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "$ref": "#/$defs/executionErrorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmpty"
      }
    },
    "objectMap": {
      "type": "object",
      "additionalProperties": true
    },
    "hostCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "arch",
        "version",
        "supportedRuntimes",
        "maxConcurrentWorkers"
      ],
      "properties": {
        "os": {
          "enum": ["macos", "linux", "windows"]
        },
        "arch": {
          "enum": ["arm64", "x64"]
        },
        "version": {
          "$ref": "#/$defs/nonEmpty"
        },
        "supportedRuntimes": {
          "$ref": "#/$defs/stringList"
        },
        "maxConcurrentWorkers": {
          "type": "integer",
          "minimum": 1
        },
        "customCapabilities": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "assignmentSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignmentId",
        "workspaceId",
        "projectId",
        "runId",
        "taskId",
        "attemptId",
        "requestedByUserId",
        "hostId",
        "workerId",
        "credentialProfileId",
        "config",
        "sessionPolicy",
        "permissions",
        "contextRefs",
        "timeoutMs",
        "idempotencyKey"
      ],
      "properties": {
        "assignmentId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "workspaceId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "projectId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "runId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "taskId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "attemptId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "requestedByUserId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "hostId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "workerId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "credentialProfileId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "model": {
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/objectMap"
        },
        "sessionPolicy": {
          "enum": [
            "stateless",
            "durable_session",
            "isolated_workspace",
            "reuse_session",
            "persistent_context"
          ]
        },
        "sessionKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "permissions": {
          "$ref": "#/$defs/stringList"
        },
        "contextRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objectMap"
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000
        },
        "idempotencyKey": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "hostHelloPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "name", "hostname", "hostVersion", "capabilities"],
      "properties": {
        "hostId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "name": {
          "$ref": "#/$defs/nonEmpty"
        },
        "hostname": {
          "$ref": "#/$defs/nonEmpty"
        },
        "hostVersion": {
          "$ref": "#/$defs/nonEmpty"
        },
        "capabilities": {
          "$ref": "#/$defs/hostCapabilities"
        },
        "enrolledWorkspaces": {
          "$ref": "#/$defs/stringList"
        },
        "authCredentials": {
          "$ref": "#/$defs/objectMap"
        }
      }
    },
    "hostHelloAckPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "status", "authenticatedAt", "serverVersion"],
      "properties": {
        "hostId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "status": {
          "enum": ["authenticated", "rejected"]
        },
        "authenticatedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "serverVersion": {
          "$ref": "#/$defs/nonEmpty"
        },
        "sessionToken": {
          "$ref": "#/$defs/nonEmpty"
        },
        "activeWorkspaceBindings": {
          "$ref": "#/$defs/stringList"
        },
        "rejectionReason": {
          "type": "string"
        }
      }
    },
    "hostHeartbeatPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "timestamp"],
      "properties": {
        "hostId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "timestamp": {
          "$ref": "#/$defs/timestamp"
        },
        "metrics": {
          "$ref": "#/$defs/objectMap"
        }
      }
    },
    "hostHeartbeatAckPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "acknowledgedAt", "serverTime"],
      "properties": {
        "hostId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "acknowledgedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "serverTime": {
          "$ref": "#/$defs/timestamp"
        },
        "nextHeartbeatIntervalMs": {
          "type": "integer",
          "minimum": 1000
        }
      }
    },
    "hostSyncRequestPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId"],
      "properties": {
        "hostId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "syncToken": {
          "type": "string"
        },
        "knownAssignmentIds": {
          "$ref": "#/$defs/stringList"
        },
        "knownWorkerIds": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "hostSyncResultPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "syncToken"],
      "properties": {
        "hostId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "syncToken": {
          "$ref": "#/$defs/nonEmpty"
        },
        "pendingAssignments": {
          "$ref": "#/$defs/stringList"
        },
        "installedWorkers": {
          "$ref": "#/$defs/stringList"
        },
        "credentialStatuses": {
          "$ref": "#/$defs/objectMap"
        }
      }
    },
    "hostStatusPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "status"],
      "properties": {
        "hostId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "status": {
          "enum": ["online", "draining", "offline"]
        },
        "activeAssignmentsCount": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "hostUpdatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostId",
        "targetVersion",
        "packageDigest",
        "packageR2Key",
        "signature"
      ],
      "properties": {
        "hostId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "targetVersion": {
          "$ref": "#/$defs/nonEmpty"
        },
        "packageDigest": {
          "$ref": "#/$defs/nonEmpty"
        },
        "packageR2Key": {
          "$ref": "#/$defs/nonEmpty"
        },
        "signature": {
          "$ref": "#/$defs/nonEmpty"
        },
        "channel": {
          "enum": ["stable", "beta", "development"]
        }
      }
    },
    "realtimeEventPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entityId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "status": {
          "$ref": "#/$defs/nonEmpty"
        },
        "message": {
          "type": "string",
          "maxLength": 32768
        },
        "summary": {
          "type": "string",
          "maxLength": 32768
        },
        "text": {
          "type": "string",
          "maxLength": 32768
        },
        "delta": {
          "type": "string",
          "maxLength": 8192
        },
        "tool": {
          "$ref": "#/$defs/nonEmpty"
        },
        "artifactId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "findingId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "verificationId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "workRequestId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "workstreamId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "stepKind": {
          "$ref": "#/$defs/nonEmpty"
        },
        "hostId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "workerId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "credentialProfileId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "tokenCount": {
          "type": "integer",
          "minimum": 0
        },
        "coalesced": {
          "type": "boolean"
        }
      }
    },
    "assignmentStartPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "input"],
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/assignmentSnapshot"
        },
        "input": {
          "$ref": "#/$defs/objectMap"
        }
      }
    },
    "assignmentAckPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignmentId",
        "hostId",
        "workerId",
        "status",
        "acknowledgedAt"
      ],
      "properties": {
        "assignmentId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "hostId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "workerId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "status": {
          "enum": ["accepted", "rejected"]
        },
        "acknowledgedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "rejectionReason": {
          "type": "string"
        }
      }
    },
    "assignmentProgressPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignmentId", "percentage", "observedAt"],
      "properties": {
        "assignmentId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "message": {
          "type": "string"
        },
        "observedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "metrics": {
          "$ref": "#/$defs/objectMap"
        }
      }
    },
    "assignmentResultPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignmentId", "status", "output", "completedAt"],
      "properties": {
        "assignmentId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "status": {
          "enum": ["completed", "failed", "cancelled"]
        },
        "output": {
          "type": ["object", "null"]
        },
        "findings": {
          "type": "array"
        },
        "artifactIds": {
          "$ref": "#/$defs/stringList"
        },
        "completedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "assignmentErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignmentId", "error", "failedAt"],
      "properties": {
        "assignmentId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "error": {
