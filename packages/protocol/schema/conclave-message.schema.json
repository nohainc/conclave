            "revision": { "$ref": "#/$defs/nonEmpty" },
            "path": { "$ref": "#/$defs/nonEmpty" },
            "expectedDigest": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "taskId",
            "repositoryId",
            "revision",
            "command",
            "cwd",
            "changedFiles"
