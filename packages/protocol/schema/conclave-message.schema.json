{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conclaveax.com/schemas/conclave-message.schema.json",
  "title": "Conclave canonical message",
  "description": "Strict cross-language contract shared by Conclave Cloud, App, Host, and Workers.",
  "x-protocol-version": "0.1",
  "x-host-protocol": {
    "name": "conclave.host-protocol",
    "version": "4.0",
    "maxMessageSizeBytes": 4194304,
    "messageTypes": [
      "host.hello",
      "host.hello.ack",
      "host.heartbeat",
      "host.heartbeat.ack",
      "host.sync.request",
      "host.sync.result",
      "host.status",
      "host.update",
      "worker.install",
      "worker.remove",
      "worker.status",
      "credential.status",
      "assignment.start",
      "assignment.ack",
      "assignment.progress",
      "assignment.result",
      "assignment.error",
      "assignment.cancel",
      "assignment.cancel.ack"
    ],
    "baseEnvelopeFields": [
      "protocol",
      "protocolVersion",
      "messageId",
      "correlationId",
      "timestamp",
      "type",
      "payload"
    ],
    "assignmentEnvelopeFields": [
      "workspaceId",
      "hostId",
      "workerId",
      "runId",
      "taskId",
      "attemptId",
      "assignmentId",
      "idempotencyKey"
    ],
    "payloadSchemas": {
      "host.hello": "#/$defs/hostHelloPayload",
      "host.hello.ack": "#/$defs/hostHelloAckPayload",
      "host.heartbeat": "#/$defs/hostHeartbeatPayload",
      "host.heartbeat.ack": "#/$defs/hostHeartbeatAckPayload",
      "host.sync.request": "#/$defs/hostSyncRequestPayload",
      "host.sync.result": "#/$defs/hostSyncResultPayload",
      "host.status": "#/$defs/hostStatusPayload",
      "host.update": "#/$defs/hostUpdatePayload",
      "worker.install": "#/$defs/workerInstallPayload",
      "worker.remove": "#/$defs/workerRemovePayload",
      "worker.status": "#/$defs/workerStatusPayload",
      "credential.status": "#/$defs/credentialStatusPayload",
      "assignment.start": "#/$defs/assignmentStartPayload",
      "assignment.ack": "#/$defs/assignmentAckPayload",
      "assignment.progress": "#/$defs/assignmentProgressPayload",
      "assignment.result": "#/$defs/assignmentResultPayload",
      "assignment.error": "#/$defs/assignmentErrorPayload",
      "assignment.cancel": "#/$defs/assignmentCancelPayload",
      "assignment.cancel.ack": "#/$defs/assignmentCancelAckPayload"
    }
  },
  "x-worker-protocol": {
    "name": "conclave.worker-protocol",
    "version": "4.0",
    "jsonRpcVersion": "2.0",
    "methods": [
      "initialize",
      "health",
      "describe",
      "execute",
      "cancel",
      "shutdown"
    ],
    "notifications": [
      "progress",
      "usage",
      "artifact",
      "result",
      "error",
      "log"
    ],
    "payloadSchemas": {
      "initialize": "#/$defs/workerInitializeParams",
      "health": "#/$defs/workerEmptyParams",
      "describe": "#/$defs/workerEmptyParams",
      "execute": "#/$defs/workerExecuteParams",
      "cancel": "#/$defs/workerCancelParams",
      "shutdown": "#/$defs/workerShutdownParams",
      "progress": "#/$defs/workerProgressNotification",
      "usage": "#/$defs/workerUsageNotification",
      "artifact": "#/$defs/workerArtifactNotification",
      "result": "#/$defs/workerResultNotification",
      "error": "#/$defs/workerErrorNotification",
      "log": "#/$defs/workerLogNotification"
    }
  },
  "x-realtime-events": {
    "name": "conclave.realtime-events",
    "version": "1.0",
    "envelopeFields": [
      "eventId",
      "type",
      "version",
      "timestamp",
      "workspaceId",
      "sequence",
      "payload"
    ],
    "optionalEnvelopeFields": [
      "projectId",
      "chatId",
      "runId",
      "taskId",
      "attemptId",
      "assignmentId",
      "hostId"
    ],
    "durableTypes": [
      "chat.message.created",
      "run.started",
      "run.paused",
      "run.resumed",
      "run.completed",
      "run.failed",
      "task.started",
      "task.completed",
      "task.failed",
      "attempt.started",
      "attempt.completed",
      "attempt.failed",
      "assignment.accepted",
      "assignment.completed",
      "assignment.failed",
      "assignment.cancelled",
      "artifact.created",
      "finding.created",
      "finding.resolved",
      "verification.completed",
      "host.enrolled",
      "host.revoked",
      "account.sharing.changed"
    ],
    "ephemeralTypes": [
      "assignment.progress",
      "worker.status",
      "stream.delta",
      "tool.invocation.status",
      "typing",
      "heartbeat",
      "host.load"
    ],
    "payloadSchema": "#/$defs/realtimeEventPayload"
  },
  "x-agent-protocol": {
    "name": "conclave.agent-protocol",
    "version": "2.0",
    "maxMessageSizeBytes": 4194304,
    "messageTypes": [
      "agent.hello",
      "agent.hello.ack",
      "agent.heartbeat",
      "agent.heartbeat.ack",
      "agent.sync.request",
      "agent.sync.response",
      "agent.capabilities",
      "agent.update.available",
      "agent.update.status",
      "plugin.install",
      "plugin.update",
      "plugin.remove",
      "plugin.status",
      "worker.configure",
      "worker.status",
      "assignment.start",
      "assignment.ack",
      "assignment.progress",
      "assignment.result",
      "assignment.error",
      "assignment.cancelled",
      "assignment.cancel",
      "assignment.cancel.ack"
    ],
    "baseEnvelopeFields": [
      "protocol",
      "protocolVersion",
      "messageId",
      "correlationId",
      "timestamp",
      "type",
      "payload"
    ],
    "assignmentEnvelopeFields": [
      "workspaceId",
      "agentId",
      "workerId",
      "runId",
      "taskId",
      "attemptId",
      "assignmentId",
      "idempotencyKey"
    ]
  },
  "x-local-protocols": {
    "agentAppIpc": {
      "name": "conclave.agent-app-ipc",
      "version": "1.0",
      "maxFrameBytes": 1048576,
      "commandTypes": [
        "engine.status",
        "engine.logs",
        "engine.restart",
        "engine.update"
      ]
    },
    "workerPlugin": {
      "name": "conclave.worker-plugin",
      "version": "2.0",
      "jsonRpcVersion": "2.0",
      "methods": [
        "initialize",
        "health",
        "getCapabilities",
        "configureWorker",
        "startAssignment",
        "cancelAssignment",
        "shutdown",
        "get_capabilities",
        "configure_worker",
        "start_assignment",
        "cancel_assignment"
      ],
      "notifications": [
        "progress",
        "log",
        "artifact",
        "usage",
        "result",
        "error",
        "authentication_required",
        "rate_limited"
      ]
    }
  },
  "x-message-types": [
    "PlanRequest",
    "PlanResult",
    "TaskRequest",
    "TaskResult",
    "ResearchResult",
    "ImplementationResult",
    "ReviewResult",
    "TestResult",
    "VerificationResult",
    "DecisionResult",
    "CompletionResult",
    "RuntimeOperationRequest"
  ],
  "x-message-payloads": {
    "PlanRequest": "#/$defs/planRequestPayload",
    "PlanResult": "#/$defs/planResultPayload",
    "TaskRequest": "#/$defs/taskRequestPayload",
    "TaskResult": "#/$defs/taskResultPayload",
    "ResearchResult": "#/$defs/researchResultPayload",
    "ImplementationResult": "#/$defs/implementationResultPayload",
    "ReviewResult": "#/$defs/reviewResultPayload",
    "TestResult": "#/$defs/testResultPayload",
    "VerificationResult": "#/$defs/verificationResultPayload",
    "DecisionResult": "#/$defs/decisionResultPayload",
    "CompletionResult": "#/$defs/completionResultPayload",
    "RuntimeOperationRequest": "#/$defs/runtimeOperationPayload"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "messageId",
    "goalId",
    "runId",
    "workerId",
    "createdAt",
    "messageType",
    "payload"
  ],
  "properties": {
    "protocol": { "const": "conclave.protocol" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "messageId": { "$ref": "#/$defs/id" },
    "goalId": { "$ref": "#/$defs/id" },
    "runId": { "$ref": "#/$defs/id" },
    "workerId": { "$ref": "#/$defs/id" },
    "createdAt": { "type": "string", "format": "date-time" },
    "messageType": {
      "type": "string",
      "enum": [
        "PlanRequest",
        "PlanResult",
        "TaskRequest",
        "TaskResult",
        "ResearchResult",
        "ImplementationResult",
        "ReviewResult",
        "TestResult",
        "VerificationResult",
        "DecisionResult",
        "CompletionResult",
        "RuntimeOperationRequest"
      ]
    },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "messageType": { "const": "PlanRequest" } } },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/planRequestPayload" } }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "PlanResult" } } },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/planResultPayload" } }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "TaskRequest" } } },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/taskRequestPayload" } }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "TaskResult" } } },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/taskResultPayload" } }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "ResearchResult" } } },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/researchResultPayload" } }
      }
    },
    {
      "if": {
        "properties": { "messageType": { "const": "ImplementationResult" } }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/implementationResultPayload" }
        }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "ReviewResult" } } },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/reviewResultPayload" } }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "TestResult" } } },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/testResultPayload" } }
      }
    },
    {
      "if": {
        "properties": { "messageType": { "const": "VerificationResult" } }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/verificationResultPayload" }
        }
      }
    },
    {
      "if": { "properties": { "messageType": { "const": "DecisionResult" } } },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/decisionResultPayload" } }
      }
    },
    {
      "if": {
        "properties": { "messageType": { "const": "CompletionResult" } }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/completionResultPayload" }
        }
      }
    },
    {
      "if": {
        "properties": { "messageType": { "const": "RuntimeOperationRequest" } }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/runtimeOperationPayload" }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "objectMap": {
      "type": "object",
      "additionalProperties": true
    },
    "hostCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "arch",
        "version",
        "supportedRuntimes",
        "maxConcurrentWorkers"
      ],
      "properties": {
        "os": { "enum": ["macos", "linux", "windows"] },
        "arch": { "enum": ["arm64", "x64"] },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "supportedRuntimes": { "$ref": "#/$defs/stringList" },
        "maxConcurrentWorkers": { "type": "integer", "minimum": 1 },
        "customCapabilities": { "$ref": "#/$defs/stringList" }
      }
    },
    "assignmentSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignmentId",
        "workspaceId",
        "projectId",
        "runId",
        "taskId",
        "attemptId",
        "requestedByUserId",
        "hostId",
        "workerId",
        "resolvedWorkerVersion",
        "credentialProfileId",
        "config",
        "sessionPolicy",
        "permissions",
        "contextRefs",
        "timeoutMs",
        "idempotencyKey"
      ],
      "properties": {
        "assignmentId": { "$ref": "#/$defs/nonEmpty" },
        "workspaceId": { "$ref": "#/$defs/nonEmpty" },
        "projectId": { "$ref": "#/$defs/nonEmpty" },
        "runId": { "$ref": "#/$defs/nonEmpty" },
        "taskId": { "$ref": "#/$defs/nonEmpty" },
        "attemptId": { "$ref": "#/$defs/nonEmpty" },
        "requestedByUserId": { "$ref": "#/$defs/nonEmpty" },
        "hostId": { "$ref": "#/$defs/nonEmpty" },
        "workerId": { "$ref": "#/$defs/nonEmpty" },
        "resolvedWorkerVersion": { "$ref": "#/$defs/nonEmpty" },
        "credentialProfileId": { "$ref": "#/$defs/nonEmpty" },
        "model": { "type": "string" },
        "config": { "$ref": "#/$defs/objectMap" },
        "sessionPolicy": {
          "enum": [
            "stateless",
            "isolated_workspace",
            "reuse_session",
            "persistent_context"
          ]
        },
        "permissions": { "$ref": "#/$defs/stringList" },
        "contextRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/objectMap" }
        },
        "timeoutMs": { "type": "integer", "minimum": 1000 },
        "idempotencyKey": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "hostHelloPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "name", "hostname", "hostVersion", "capabilities"],
      "properties": {
        "hostId": { "$ref": "#/$defs/nonEmpty" },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "hostname": { "$ref": "#/$defs/nonEmpty" },
        "hostVersion": { "$ref": "#/$defs/nonEmpty" },
        "capabilities": { "$ref": "#/$defs/hostCapabilities" },
        "enrolledWorkspaces": { "$ref": "#/$defs/stringList" },
        "authCredentials": { "$ref": "#/$defs/objectMap" }
      }
    },
    "hostHelloAckPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "status", "authenticatedAt", "serverVersion"],
      "properties": {
        "hostId": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["authenticated", "rejected"] },
        "authenticatedAt": { "$ref": "#/$defs/timestamp" },
        "serverVersion": { "$ref": "#/$defs/nonEmpty" },
        "sessionToken": { "$ref": "#/$defs/nonEmpty" },
        "activeWorkspaceBindings": { "$ref": "#/$defs/stringList" },
        "rejectionReason": { "type": "string" }
      }
    },
    "hostHeartbeatPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "timestamp"],
      "properties": {
        "hostId": { "$ref": "#/$defs/nonEmpty" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "metrics": { "$ref": "#/$defs/objectMap" }
      }
    },
    "hostHeartbeatAckPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "acknowledgedAt", "serverTime"],
      "properties": {
        "hostId": { "$ref": "#/$defs/nonEmpty" },
        "acknowledgedAt": { "$ref": "#/$defs/timestamp" },
        "serverTime": { "$ref": "#/$defs/timestamp" },
        "nextHeartbeatIntervalMs": { "type": "integer", "minimum": 1000 }
      }
    },
    "hostSyncRequestPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId"],
      "properties": {
        "hostId": { "$ref": "#/$defs/nonEmpty" },
        "syncToken": { "type": "string" },
        "knownAssignmentIds": { "$ref": "#/$defs/stringList" },
        "knownWorkerIds": { "$ref": "#/$defs/stringList" }
      }
    },
    "hostSyncResultPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "syncToken"],
      "properties": {
        "hostId": { "$ref": "#/$defs/nonEmpty" },
        "syncToken": { "$ref": "#/$defs/nonEmpty" },
        "pendingAssignments": { "$ref": "#/$defs/stringList" },
        "installedWorkers": { "$ref": "#/$defs/stringList" },
        "credentialStatuses": { "$ref": "#/$defs/objectMap" }
      }
    },
    "hostStatusPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "status"],
      "properties": {
        "hostId": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["online", "draining", "offline"] },
        "activeAssignmentsCount": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string" }
      }
    },
    "hostUpdatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostId",
        "targetVersion",
        "packageDigest",
        "packageR2Key",
        "signature"
      ],
      "properties": {
        "hostId": { "$ref": "#/$defs/nonEmpty" },
        "targetVersion": { "$ref": "#/$defs/nonEmpty" },
        "packageDigest": { "$ref": "#/$defs/nonEmpty" },
        "packageR2Key": { "$ref": "#/$defs/nonEmpty" },
        "signature": { "$ref": "#/$defs/nonEmpty" },
        "channel": { "enum": ["stable", "beta", "development"] }
      }
    },
    "workerInstallPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostId",
        "workerId",
        "version",
        "packageDigest",
        "packageR2Key",
        "signature",
        "entrypoint"
      ],
      "properties": {
        "hostId": { "$ref": "#/$defs/nonEmpty" },
        "workerId": { "$ref": "#/$defs/nonEmpty" },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "packageDigest": { "$ref": "#/$defs/nonEmpty" },
        "packageR2Key": { "$ref": "#/$defs/nonEmpty" },
        "signature": { "$ref": "#/$defs/nonEmpty" },
        "entrypoint": { "$ref": "#/$defs/nonEmpty" },
        "permissions": { "$ref": "#/$defs/stringList" }
      }
    },
    "workerRemovePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "workerId"],
      "properties": {
        "hostId": { "$ref": "#/$defs/nonEmpty" },
        "workerId": { "$ref": "#/$defs/nonEmpty" },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "purgeData": { "type": "boolean" }
      }
    },
    "workerStatusPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "workerId", "version", "status"],
      "properties": {
        "hostId": { "$ref": "#/$defs/nonEmpty" },
        "workerId": { "$ref": "#/$defs/nonEmpty" },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["installed", "installing", "failed", "removed"] },
        "error": { "type": "string" }
      }
    },
    "credentialStatusPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostId",
        "credentialProfileId",
        "workerId",
        "status",
        "authMode",
        "lastCheckedAt"
      ],
      "properties": {
        "hostId": { "$ref": "#/$defs/nonEmpty" },
        "credentialProfileId": { "$ref": "#/$defs/nonEmpty" },
        "workerId": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["ready", "needs_auth", "invalid", "expired"] },
        "authMode": {
          "enum": [
            "none",
            "api_key",
            "oauth_browser",
            "local_cli_session",
            "interactive_custom"
          ]
        },
        "visibility": { "enum": ["private", "workspace"] },
        "lastCheckedAt": { "$ref": "#/$defs/timestamp" },
        "errorMessage": { "type": "string" }
      }
    },
    "realtimeEventPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entityId": { "$ref": "#/$defs/nonEmpty" },
        "status": { "$ref": "#/$defs/nonEmpty" },
        "message": { "type": "string", "maxLength": 32768 },
        "summary": { "type": "string", "maxLength": 32768 },
        "text": { "type": "string", "maxLength": 32768 },
        "delta": { "type": "string", "maxLength": 8192 },
        "tool": { "$ref": "#/$defs/nonEmpty" },
        "artifactId": { "$ref": "#/$defs/nonEmpty" },
        "findingId": { "$ref": "#/$defs/nonEmpty" },
        "verificationId": { "$ref": "#/$defs/nonEmpty" },
        "hostId": { "$ref": "#/$defs/nonEmpty" },
        "workerId": { "$ref": "#/$defs/nonEmpty" },
        "credentialProfileId": { "$ref": "#/$defs/nonEmpty" },
        "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "tokenCount": { "type": "integer", "minimum": 0 },
        "coalesced": { "type": "boolean" }
      }
    },
    "assignmentStartPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "input"],
      "properties": {
        "snapshot": { "$ref": "#/$defs/assignmentSnapshot" },
        "input": { "$ref": "#/$defs/objectMap" }
      }
    },
    "assignmentAckPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignmentId",
        "hostId",
        "workerId",
        "status",
        "acknowledgedAt"
      ],
      "properties": {
        "assignmentId": { "$ref": "#/$defs/nonEmpty" },
        "hostId": { "$ref": "#/$defs/nonEmpty" },
        "workerId": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["accepted", "rejected"] },
        "acknowledgedAt": { "$ref": "#/$defs/timestamp" },
        "rejectionReason": { "type": "string" }
      }
    },
    "assignmentProgressPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignmentId", "percentage", "observedAt"],
      "properties": {
        "assignmentId": { "$ref": "#/$defs/nonEmpty" },
        "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "message": { "type": "string" },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "metrics": { "$ref": "#/$defs/objectMap" }
      }
    },
    "assignmentResultPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignmentId", "status", "output", "completedAt"],
      "properties": {
        "assignmentId": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["completed", "failed", "cancelled"] },
        "output": { "type": ["object", "null"] },
        "findings": { "type": "array" },
        "artifactIds": { "$ref": "#/$defs/stringList" },
        "completedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "assignmentErrorPayload": {
