{
  "workerTypeId": "claude-code",
  "adapterVersion": "1.0.0",
  "protocolVersion": "1.0",
  "publisher": "conclave",
  "displayName": "Claude Code",
  "supportedPlatforms": [
    "macos-arm64",
    "macos-x64",
    "linux-arm64",
    "linux-x64"
  ],
  "capabilities": ["code", "repository", "shell"],
  "permissions": ["workspace:read", "workspace:write", "shell:execute"],
  "authStrategies": ["browser_auth"],
  "modelSelectionMode": "allow_list",
  "prerequisites": [
    { "kind": "executable", "executable": "node", "minimumVersion": "18.0.0" },
    { "kind": "executable", "executable": "claude", "minimumVersion": "2.1.41" }
  ],
  "executable": "bin/conclave-claude-code-adapter.mjs",
  "launchArgs": [],
  "secretRequirements": [],
  "healthCheck": { "mode": "protocol", "timeoutMs": 5000 },
  "packageDigest": "<calculated-from-package-contents-on-publish>",
  "signingKeyId": "<key-id-on-publish>",
  "signature": "<publisher-signature-on-publish>",
  "releaseChannel": "stable"
}
