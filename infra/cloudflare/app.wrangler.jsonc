{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "conclave-ax-app",
  "main": "../../apps/cloud/src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "directory": "../../apps/app/build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"],
  },
  "send_email": [
    {
      "name": "CONCLAVE_EMAIL",
    },
  ],
  "vars": {
    "CONCLAVE_PROFILE_LAB_OWNER_EMAIL": "vitalii@nohainc.com",
    "CONCLAVE_ENVIRONMENT": "production",
    "BETTER_AUTH_URL": "https://app.conclaveax.com",
    "CONCLAVE_EMAIL_FROM": "auth@auth.earthuc.com",
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"],
  },
  "d1_databases": [
    {
      "binding": "CONCLAVE_DB",
      "database_name": "conclave-v8-production",
      "database_id": "50a2b0dd-5f3d-4fab-af12-93cd96831701",
      "migrations_dir": "../../apps/cloud/migrations-v8",
    },
  ],
  "r2_buckets": [
    {
      "binding": "CONCLAVE_ARTIFACTS",
      "bucket_name": "conclave-artifacts-production",
    },
  ],
  "workflows": [
    {
      "name": "conclave-run",
      "binding": "CONCLAVE_RUN_WORKFLOW",
      "class_name": "ConclaveRunWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONCLAVE_WORKSPACE_GATEWAY",
        "class_name": "WorkspaceGateway",
      },
      {
        "name": "CONCLAVE_REALTIME_GATEWAY",
        "class_name": "RealtimeGateway",
      },
      {
        "name": "CONCLAVE_THREAD_COORDINATOR",
        "class_name": "ThreadExecutionCoordinator",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-runtime-connection",
      "new_sqlite_classes": ["RuntimeConnection", "AgentGateway"],
    },
    {
      "tag": "v2-host-and-realtime-gateway",
      "deleted_classes": ["RuntimeConnection", "AgentGateway"],
      "new_sqlite_classes": ["HostGateway", "RealtimeGateway"],
    },
    {
      "tag": "v3-workspace-and-realtime-gateway",
      "deleted_classes": ["HostGateway"],
      "new_sqlite_classes": ["WorkspaceGateway"],
    },
    {
      "tag": "v8-thread-coordinator",
      "new_sqlite_classes": ["ThreadExecutionCoordinator"],
    },
  ],
  "routes": [
    {
      "pattern": "app.conclaveax.com",
      "custom_domain": true,
    },
  ],
}
