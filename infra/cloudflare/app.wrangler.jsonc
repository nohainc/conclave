{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "conclave-ax-app",
  "main": "../../apps/worker/src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "directory": "../../apps/studio/build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"],
  },
  "vars": {
    "CONCLAVE_ENVIRONMENT": "production",
    "CONCLAVE_PLUGIN_PUBLISHER_EMAIL": "vitalii@nohainc.com",
  },
  "d1_databases": [
    {
      "binding": "CONCLAVE_DB",
      "database_name": "conclave-production",
      "database_id": "c10d0f8f-71a5-47e9-a60c-be84d6643ba7",
      "migrations_dir": "../../apps/worker/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "CONCLAVE_ARTIFACTS",
      "bucket_name": "conclave-artifacts-production",
    },
  ],
  "services": [
    {
      "binding": "CONCLAVE_FORGE_EXECUTION",
      "service": "conclave-forge-execution",
    },
  ],
  "workflows": [
    {
      "name": "conclave-run",
      "binding": "CONCLAVE_RUN_WORKFLOW",
      "class_name": "ConclaveRunWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONCLAVE_AGENT_GATEWAY",
        "class_name": "AgentGateway",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-agent-gateway",
      "new_sqlite_classes": ["AgentGateway"],
    },
  ],
  "routes": [
    {
      "pattern": "app.conclaveax.com",
      "custom_domain": true,
    },
  ],
}
