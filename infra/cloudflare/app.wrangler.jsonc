{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "syntila-app",
  "main": "../../apps/cloud/src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/5 * * * *", "17 3 * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "directory": "../../apps/app/build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"],
  },
  "send_email": [
    {
      "name": "SYNTILA_EMAIL",
    },
  ],
  "vars": {
    "SYNTILA_PROFILE_LAB_OWNER_EMAIL": "vitalii@nohainc.com",
    "SYNTILA_ENVIRONMENT": "production",
    "BETTER_AUTH_URL": "https://syntila.app",
    "SYNTILA_APP_URL": "https://syntila.app",
    "SYNTILA_EMAIL_FROM": "syntila@conclaveax.com",
    "SYNTILA_EMAIL_FALLBACK_FROM": "vitalii@conclaveax.com",
    "SYNTILA_EMAIL_FROM_NAME": "Syntila",
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"],
  },
  "d1_databases": [
    {
      "binding": "SYNTILA_DB",
      "database_name": "syntila",
      "database_id": "6130c425-59e2-4ec7-b7bd-d3fe8a8ea6a7",
      "migrations_dir": "../../apps/cloud/migrations-v8",
    },
  ],
  "r2_buckets": [
    {
      "binding": "SYNTILA_ARTIFACTS",
      "bucket_name": "syntila-artifacts-production",
    },
  ],
  "workflows": [
    {
      "name": "syntila-run",
      "binding": "SYNTILA_RUN_WORKFLOW",
      "class_name": "SyntilaRunWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNTILA_WORKSPACE_GATEWAY",
        "class_name": "WorkspaceGateway",
      },
      {
        "name": "SYNTILA_REALTIME_GATEWAY",
        "class_name": "RealtimeGateway",
      },
      {
        "name": "SYNTILA_THREAD_COORDINATOR",
        "class_name": "ThreadExecutionCoordinator",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-runtime-connection",
      "new_sqlite_classes": ["RuntimeConnection", "AgentGateway"],
    },
    {
      "tag": "v2-host-and-realtime-gateway",
      "deleted_classes": ["RuntimeConnection", "AgentGateway"],
      "new_sqlite_classes": ["HostGateway", "RealtimeGateway"],
    },
    {
      "tag": "v3-workspace-and-realtime-gateway",
      "deleted_classes": ["HostGateway"],
      "new_sqlite_classes": ["WorkspaceGateway"],
    },
    {
      // Applied production history must retain its original class and tag.
      "tag": "v8-workstream-coordinator",
      "new_sqlite_classes": ["WorkstreamExecutionCoordinator"],
    },
    {
      "tag": "v9-thread-coordinator-rename",
      "renamed_classes": [
        {
          "from": "WorkstreamExecutionCoordinator",
          "to": "ThreadExecutionCoordinator",
        },
      ],
    },
  ],
  "routes": [
    {
      "pattern": "syntila.app",
      "custom_domain": true,
    },
  ],
}
