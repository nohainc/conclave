{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "conclave-ax-app",
  "main": "../../apps/cloud/src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "directory": "../../apps/app/build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"],
  },
  "send_email": [
    {
      "name": "CONCLAVE_EMAIL",
    },
  ],
  "vars": {
    "CONCLAVE_ENVIRONMENT": "production",
    "CONCLAVE_PLUGIN_PUBLISHER_EMAIL": "vitalii@nohainc.com",
    "BETTER_AUTH_URL": "https://app.conclaveax.com",
    "CONCLAVE_EMAIL_FROM": "auth@auth.earthuc.com",
  },
  "d1_databases": [
    {
      "binding": "CONCLAVE_DB",
      "database_name": "conclave-production",
      "database_id": "09b20c15-ba5b-413a-85de-17f3480fd1c2",
      "migrations_dir": "../../apps/cloud/migrations-v6",
    },
  ],
  "r2_buckets": [
    {
      "binding": "CONCLAVE_ARTIFACTS",
      "bucket_name": "conclave-artifacts-production",
    },
  ],
  "services": [
    {
      "binding": "CONCLAVE_FORGE_EXECUTION",
      "service": "conclave-forge-execution",
    },
  ],
  "workflows": [
    {
      "name": "conclave-run",
      "binding": "CONCLAVE_RUN_WORKFLOW",
      "class_name": "ConclaveRunWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONCLAVE_WORKSPACE_GATEWAY",
        "class_name": "WorkspaceGateway",
      },
      {
        "name": "CONCLAVE_REALTIME_GATEWAY",
        "class_name": "RealtimeGateway",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-runtime-connection",
      "new_sqlite_classes": ["RuntimeConnection", "AgentGateway"],
    },
    {
      "tag": "v3-workspace-and-realtime-gateway",
      "deleted_classes": ["RuntimeConnection", "AgentGateway", "HostGateway"],
      "new_sqlite_classes": ["WorkspaceGateway", "RealtimeGateway"],
    },
  ],
  "routes": [
    {
      "pattern": "app.conclaveax.com",
      "custom_domain": true,
    },
  ],
}
