{
  "name": "conclave",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "tsc -p packages/protocol/tsconfig.json && tsc -p packages/workspace-runtime-protocol/tsconfig.json && tsc -p packages/security/tsconfig.json && tsc -p packages/core/tsconfig.json && tsc -p packages/tool-profile/tsconfig.json && tsc -p apps/cloud/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run packages/protocol/test packages/workspace-runtime-protocol/test packages/security/test packages/core/test packages/tool-profile/test apps/cloud/test scripts/verify-v8-architecture.test.mjs",
    "workspace:build": "bash scripts/build-workspace.sh",
    "workspace:build:macos": "bash scripts/build-workspace-macos.sh",
    "workspace:test:macos": "bash scripts/test-workspace-macos.sh",
    "profile-lab:build": "bash scripts/build-profile-lab-macos.sh",
    "profile-lab:build:macos": "bash scripts/build-profile-lab-macos.sh",
    "profile-lab:test": "bash scripts/test-profile-lab-macos.sh",
    "profile-lab:test:macos": "bash scripts/test-profile-lab-macos.sh",
    "docs:check": "node scripts/verify-doc-links.mjs",
    "cloud:execution-boundary-check": "node scripts/verify-cloud-execution-boundary.mjs",
    "cloud:schema-check": "node scripts/verify-cloud-schema-references.mjs",
    "production:preflight": "node scripts/verify-production-security.mjs",
    "auth:access-guard": "node scripts/verify-no-access-auth.mjs",
    "usage:architecture-guard": "node scripts/verify-no-usage-architecture.mjs",
    "v8:architecture-check": "node scripts/verify-v8-architecture.mjs",
    "site:dev": "cd apps/site && ./node_modules/.bin/astro dev",
    "site:check": "cd apps/site && ./node_modules/.bin/astro check",
    "site:build": "cd apps/site && ./node_modules/.bin/astro build",
    "site:test": "cd apps/site && ./node_modules/.bin/vitest run test",
    "site:performance": "cd apps/site && node scripts/check-performance.mjs",
    "site:accessibility": "cd apps/site && node scripts/check-accessibility.mjs",
    "site:responsive": "cd apps/site && node scripts/check-responsive.mjs",
    "site:analytics": "cd apps/site && node scripts/check-analytics-privacy.mjs",
    "site:security": "cd apps/site && node scripts/check-security.mjs",
    "site:content": "cd apps/site && node scripts/check-content.mjs",
    "site:release": "cd apps/site && node scripts/check-release.mjs",
    "site:preview": "cd apps/site && ./node_modules/.bin/astro preview",
    "check:dart": "bash scripts/check-dart-packages.sh",
    "check:fixture-e2e": "pnpm exec vitest run apps/cloud/test/v8-schema-clean-room-acceptance.test.ts apps/cloud/test/work-v1-v8-regression.acceptance.test.ts",
    "check": "pnpm cloud:schema-check && pnpm v8:architecture-check && pnpm protocol:boundaries-check && pnpm protocol:check && pnpm --dir apps/cloud types:check && pnpm usage:architecture-guard && pnpm docs:check && pnpm cloud:execution-boundary-check && pnpm production:preflight && pnpm auth:access-guard && pnpm format:check && pnpm lint && pnpm build && pnpm test && pnpm check:dart && pnpm check:fixture-e2e",
    "protocol:boundaries-check": "node scripts/verify-protocol-boundaries.mjs",
    "start:local": "./scripts/start-local.sh",
    "db:migrate:production": "./scripts/migrate-production-d1.sh",
    "protocol:generate": "node scripts/generate-protocol-bindings.mjs",
    "protocol:check": "node scripts/verify-protocol-bindings.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.38.0"
  }
}
