{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "conclave-forge-execution",
  "main": "src/forge-execution.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CONCLAVE_ENVIRONMENT": "production",
  },
  "d1_databases": [
    {
      "binding": "CONCLAVE_DB",
      "database_name": "conclave-production",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "CONCLAVE_ARTIFACTS",
      "bucket_name": "conclave-artifacts-production",
    },
  ],
  "services": [
    {
      "binding": "CONCLAVE_API",
      "service": "conclave-ax-app",
    },
  ],
}
