{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "conclave-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "CONCLAVE_ENVIRONMENT": "development",
  },
}
