{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "conclave-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "CONCLAVE_ENVIRONMENT": "development",
  },
  "d1_databases": [
    {
      "binding": "CONCLAVE_DB",
      "database_name": "conclave-development",
      "database_id": "local",
      "migrations_dir": "migrations-v4",
    },
  ],
  "r2_buckets": [
    {
      "binding": "CONCLAVE_ARTIFACTS",
      "bucket_name": "conclave-artifacts-development",
    },
  ],
  "services": [
    {
      "binding": "CONCLAVE_FORGE_EXECUTION",
      "service": "conclave-forge-execution",
    },
  ],
  "workflows": [
    {
      "name": "conclave-run",
      "binding": "CONCLAVE_RUN_WORKFLOW",
      "class_name": "ConclaveRunWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONCLAVE_HOST_GATEWAY",
        "class_name": "HostGateway",
      },
      {
        "name": "CONCLAVE_REALTIME_GATEWAY",
        "class_name": "RealtimeGateway",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-host-gateway",
      "new_sqlite_classes": ["HostGateway"],
    },
    {
      "tag": "v2-realtime-gateway",
      "new_sqlite_classes": ["RealtimeGateway"],
    },
  ],
}
