{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "conclave-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "send_email": [
    {
      "name": "CONCLAVE_EMAIL",
    },
  ],
  "vars": {
    "CONCLAVE_PROFILE_LAB_OWNER_EMAIL": "vitalii@nohainc.com",
    "CONCLAVE_ENVIRONMENT": "development",
  },
  "d1_databases": [
    {
      "binding": "CONCLAVE_DB",
      "database_name": "conclave-development",
      "database_id": "local",
      "migrations_dir": "migrations-v8",
    },
  ],
  "r2_buckets": [
    {
      "binding": "CONCLAVE_ARTIFACTS",
      "bucket_name": "conclave-artifacts-development",
    },
  ],
  "workflows": [
    {
      "name": "conclave-run",
      "binding": "CONCLAVE_RUN_WORKFLOW",
      "class_name": "ConclaveRunWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONCLAVE_WORKSPACE_GATEWAY",
        "class_name": "WorkspaceGateway",
      },
      {
        "name": "CONCLAVE_REALTIME_GATEWAY",
        "class_name": "RealtimeGateway",
      },
      {
        "name": "CONCLAVE_WORKSTREAM_COORDINATOR",
        "class_name": "WorkstreamExecutionCoordinator",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v3-workspace-gateway",
      "new_sqlite_classes": ["WorkspaceGateway"],
    },
    {
      "tag": "v2-realtime-gateway",
      "new_sqlite_classes": ["RealtimeGateway"],
    },
    {
      "tag": "v6-workstream-coordinator",
      "new_sqlite_classes": ["WorkstreamExecutionCoordinator"],
    },
  ],
}
