{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "syntila-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/5 * * * *", "17 3 * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "send_email": [
    {
      "name": "SYNTILA_EMAIL",
      "remote": true,
    },
  ],
  "vars": {
    "SYNTILA_PROFILE_LAB_OWNER_EMAIL": "vitalii@nohainc.com",
    "SYNTILA_ENVIRONMENT": "development",
    // Optional social sign-in; empty disables a provider. Declared here so
    // wrangler loads overrides from .dev.vars (with `secrets` configured it
    // only loads .dev.vars keys that are declared vars or required secrets).
    "SYNTILA_AUTH_GITHUB_CLIENT_ID": "",
    "SYNTILA_AUTH_GITHUB_CLIENT_SECRET": "",
    "SYNTILA_AUTH_GOOGLE_CLIENT_ID": "",
    "SYNTILA_AUTH_GOOGLE_CLIENT_SECRET": "",
    // Temporary local diagnostics; set REALTIME_DIAGNOSTICS=1 in .dev.vars.
    "REALTIME_DIAGNOSTICS": "",
  },
  "secrets": {
    "required": [
      "SYNTILA_RELEASE_PUBLISHER",
      "SYNTILA_RELEASE_TRUST_KEYS_JSON",
      "BETTER_AUTH_SECRET",
    ],
  },
  "d1_databases": [
    {
      "binding": "SYNTILA_DB",
      "database_name": "syntila-development",
      "database_id": "local",
      "migrations_dir": "migrations-v8",
    },
  ],
  "r2_buckets": [
    {
      "binding": "SYNTILA_ARTIFACTS",
      "bucket_name": "syntila-artifacts-development",
    },
  ],
  "workflows": [
    {
      "name": "syntila-run",
      "binding": "SYNTILA_RUN_WORKFLOW",
      "class_name": "SyntilaRunWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNTILA_WORKSPACE_GATEWAY",
        "class_name": "WorkspaceGateway",
      },
      {
        "name": "SYNTILA_REALTIME_GATEWAY",
        "class_name": "RealtimeGateway",
      },
      {
        "name": "SYNTILA_THREAD_COORDINATOR",
        "class_name": "ThreadExecutionCoordinator",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v3-workspace-gateway",
      "new_sqlite_classes": ["WorkspaceGateway"],
    },
    {
      "tag": "v2-realtime-gateway",
      "new_sqlite_classes": ["RealtimeGateway"],
    },
    {
      "tag": "v6-thread-coordinator",
      "new_sqlite_classes": ["ThreadExecutionCoordinator"],
    },
  ],
}
