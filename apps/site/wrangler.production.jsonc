{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "conclave-ax-site",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "conclaveax.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.conclaveax.com",
      "custom_domain": true,
    },
  ],
}
