---
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { workspaceRelease } from "../data/workspace-release";
---

<SiteLayout
  title="Downloads — Conclave AX"
  description="Download Conclave Workspace for macOS, Windows, or Linux to connect local tools and machines."
>
  <Section>
    <Container>
      <SectionHeader
        eyebrow="Downloads"
        title="Run Conclave Workers on your computer."
        description="Conclave AX runs directly in your web browser. If you want to connect your local development environment, repositories, and command-line coding agents, install Conclave Workspace on your machine."
        headingLevel={1}
      />

      <div class="downloads-intro-note">
        <div class="note-pill">Web App</div>
        <p>
          For general team chat, shared spaces, and API-backed AI models, you don't need to install anything. Simply <a href="https://app.conclaveax.com" class="link-inline">open Conclave AX in your browser →</a>
        </p>
      </div>

      <div class="downloads-grid" data-downloads-platforms style="margin-top: var(--space-8);">
        {workspaceRelease.targets.map((target) => (
          <article class="downloads-card" data-platform={target.platform}>
            <div class="downloads-card__header">
              <div>
                <h2>{workspaceRelease.productName}</h2>
                <p>{target.label}</p>
              </div>
              <span class="badge downloads-card__recommended" hidden>Recommended for this device</span>
            </div>
            <p class="downloads-card__version">Version {workspaceRelease.version}</p>
            <p class="downloads-card__architecture">{target.architectures.join(" / ")}</p>
            <a class="button button--primary" href={target.downloadUrl} target="_blank" rel="noreferrer">Download <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </Container>
  </Section>
</SiteLayout>

<script src="/scripts/downloads-platform.js" defer></script>
