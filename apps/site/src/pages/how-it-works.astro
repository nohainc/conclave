---
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import WorkflowStep from "../components/WorkflowStep.astro";
import SpaceThreadShowcase from "../components/SpaceThreadShowcase.astro";
---

<SiteLayout
  title="How Conclave AX works — Shared AI Workspace"
  description="See how Conclave AX connects people, shared AI accounts, focused threads, and advanced workflows in one collaborative workspace."
>
  <Section>
    <Container>
      <SectionHeader
        eyebrow="How it works"
        title="From shared ideas to verified results."
        description="Conclave AX makes using AI collaborative, transparent, and secure by giving your group one place to think, decide, and work together."
        headingLevel={1}
      />

      <div class="workflow-layout">
        <ol class="workflow-steps">
          <WorkflowStep number="01" title="Create a Space">
            <p>Set up a shared space for your family, startup, client engagement, or engineering team with customized member permissions and privacy settings.</p>
          </WorkflowStep>

          <WorkflowStep number="02" title="Invite your people">
            <p>Invite collaborators via email or direct link. Members gain immediate access to space threads and shared AI capabilities.</p>
          </WorkflowStep>

          <WorkflowStep number="03" title="Connect & share AI">
            <p>Space members can contribute supported AI accounts (such as ChatGPT or Gemini) without ever exposing API keys or credentials.</p>
          </WorkflowStep>

          <WorkflowStep number="04" title="Open a Thread">
            <p>Break major goals into focused threads—like travel itineraries, competitor research, draft messaging, or feature implementations.</p>
          </WorkflowStep>

          <WorkflowStep number="05" title="Collaborate in context">
            <p>Chat together with AI in the loop. Switch AI models on the fly to get different perspectives without losing your discussion history.</p>
          </WorkflowStep>

          <WorkflowStep number="06" title="Run Workflows when needed">
            <p>Turn complex questions into multi-step workflows. Coordinate multiple AI models to research, analyze, draft, test, and verify results.</p>
          </WorkflowStep>
        </ol>
      </div>

      <div class="how-it-works-principles">
        <div>
          <strong>Shared context by default.</strong>
          <span>Everyone in the space sees the prompts, responses, attachments, and decisions.</span>
        </div>
        <div>
          <strong>Private credentials.</strong>
          <span>Sharing an AI account authorizes use for the space; credentials remain securely encrypted and private.</span>
        </div>
        <div>
          <strong>Multi-model continuity.</strong>
          <span>Switch between supported AI Workers in the exact same thread without losing context.</span>
        </div>
      </div>

      <div style="margin-top: var(--space-16);">
        <SectionHeader
          eyebrow="Practical examples"
          title="See how spaces and threads stay organized"
          description="Keep your work structured whether you are managing everyday life or building complex software."
        />
        <SpaceThreadShowcase />
      </div>

      <div class="actions" style="justify-content: center; margin-top: var(--space-16);">
        <Button href="https://app.conclaveax.com" label="Open Conclave AX" />
        <Button href="/use-cases/" label="Explore use cases" variant="secondary" />
      </div>
    </Container>
  </Section>
</SiteLayout>
