---
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="How Conclave AX works" description="Understand the Conclave AX Cloud, Host, Worker, and Account model.">
  <Section>
    <Container>
      <SectionHeader eyebrow="How it works" title="One path from request to result." description="Conclave AX separates coordination from local capability, so your execution path stays understandable as work gets more complex." />
      <div class="cards">
        <FeatureCard title="1. Conclave AX"><p>Ask questions, start work, review progress, and inspect the result in the authenticated app.</p></FeatureCard>
        <FeatureCard title="2. Conclave Cloud"><p>Cloud authenticates people, enforces Workspace permissions, and coordinates the execution.</p></FeatureCard>
        <FeatureCard title="3. Host and Worker"><p>Your Host provides a machine. A Worker provides the AI or tool capability for one assignment.</p></FeatureCard>
      </div>
      <div class="actions"><Button href="https://app.conclaveax.com" label="Open Conclave AX" /></div>
    </Container>
  </Section>
</SiteLayout>
