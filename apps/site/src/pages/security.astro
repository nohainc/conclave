---
import Container from "../components/Container.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SecurityTopology from "../components/SecurityTopology.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Security — Conclave AX" description="Conclave AX separates Project collaboration, Workspace execution, Worker capability, and AI Account authorization.">
  <Section>
    <Container>
      <SectionHeader eyebrow="Security" title="Share the project without sharing the whole machine." description="Conclave AX uses separate authorization boundaries for people, Projects, Workstreams, Workspaces, Workers, and AI Accounts." headingLevel={1} />

      <div class="security-overview">
        <SecurityTopology />
        <div class="security-boundaries">
          <FeatureCard title="Project" headingLevel={2}><p>Defines who can collaborate, discuss, inspect results, and request work. Project membership does not grant machine access.</p></FeatureCard>
          <FeatureCard title="Workspace" headingLevel={2}><p>Represents one execution environment. Projects use it only through an explicit, scoped Workspace grant.</p></FeatureCard>
          <FeatureCard title="Worker" headingLevel={2}><p>Provides a model, tool, CLI, or other capability behind the Workspace runtime. Workers do not authenticate directly as Conclave users.</p></FeatureCard>
          <FeatureCard title="AI Account" headingLevel={2}><p>Determines which external AI identity may be used. Workspace access never implies Account access.</p></FeatureCard>
        </div>
      </div>

      <div class="security-callout">
        <strong>Effective execution permissions can only get narrower.</strong>
        <span>Project role, Workspace grant, Worker permissions, local Workspace policy, and Project policy are intersected before an Assignment is dispatched.</span>
      </div>

      <div class="cards security-detail-cards">
        <FeatureCard title="Scoped execution"><p>Repository and path mappings define where a Project may work. Full-machine access is not the normal execution path.</p></FeatureCard>
        <FeatureCard title="Isolated Workstreams"><p>Stateful Workstreams use managed checkouts and controlled concurrency so parallel project work does not share one mutable tree.</p></FeatureCard>
        <FeatureCard title="Credential isolation"><p>Secrets stay behind the Workspace boundary and are not exposed merely because another person can execute authorized Project work.</p></FeatureCard>
      </div>
    </Container>
  </Section>
</SiteLayout>
