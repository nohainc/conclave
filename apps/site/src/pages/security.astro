---
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CredentialPrivacyDiagram from "../components/CredentialPrivacyDiagram.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Security — Conclave AX"
  description="Conclave AX separates Space collaboration, AI Account authorization, and Workspace execution to keep your secrets private."
>
  <Section>
    <Container>
      <SectionHeader
        eyebrow="Security & Privacy"
        title="Share AI access without sharing your secrets."
        description="Conclave AX is architected so people can collaborate with AI together without exposing API keys, personal login credentials, or unrestricted machine access."
        headingLevel={1}
      />

      <div class="security-overview" style="margin-top: var(--space-8);">
        <CredentialPrivacyDiagram />
      </div>

      <div style="margin-top: var(--space-16);">
        <SectionHeader
          eyebrow="Authorization Boundaries"
          title="Strict separation between people, spaces, and AI."
          description="Every layer in Conclave has an independent permission boundary so access can only get narrower."
        />

        <div class="cards security-detail-cards">
          <FeatureCard title="Space Membership" headingLevel={2}>
            <p>Defines who can collaborate, participate in thread chats, and trigger AI runs. Joining a space never automatically grants access to anyone's personal AI accounts or local machines.</p>
          </FeatureCard>

          <FeatureCard title="AI Account Privacy" headingLevel={2}>
            <p>Provider credentials remain local to the owner's machine and CLI environment. Granting a Worker to a space authorizes eligible members to run queries; it never reveals the underlying secret.</p>
          </FeatureCard>

          <FeatureCard title="Workspace Isolation" headingLevel={2}>
            <p>For technical teams running code or CLI tools, work executes in the Space Work Directory on the authorized host machine with isolated Thread sessions and mutation lease serialization.</p>
          </FeatureCard>

          <FeatureCard title="Audit & Attribution" headingLevel={2}>
            <p>Execution records can attribute requests to the requester, Worker, model and available usage metadata, giving owners visibility over space activity.</p>
          </FeatureCard>
        </div>
      </div>

      <div class="security-callout" style="margin-top: var(--space-12);">
        <strong>Instant revocation with zero password churn.</strong>
        <span>Revoking a Workspace or Worker grant or removing a space collaborator immediately cuts off AI access without requiring you to regenerate API keys or reset passwords.</span>
      </div>

      <div class="actions" style="justify-content: center; margin-top: var(--space-12);">
        <Button href="https://app.conclaveax.com" label="Open Conclave AX" event="cta.open_app" />
        <Button href="/privacy/" label="Read privacy policy" variant="secondary" />
      </div>
    </Container>
  </Section>
</SiteLayout>
