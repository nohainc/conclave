---
import SiteLayout from "../layouts/SiteLayout.astro";
import ArchitectureNode from "../components/ArchitectureNode.astro";
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
---

<SiteLayout
  title="Conclave AX — AI work with a clear path to done"
  description="Conclave AX coordinates AI and tool work across your Workspace, Hosts, Workers, and Accounts."
>
  <Container>
    <section class="hero" id="product">
      <div>
      <div class="eyebrow">A clearer way to direct AI work</div>
      <h1>Move from an idea to evidence you can trust.</h1>
      <p class="lede">
        Conclave AX gives teams one place to ask, direct, review, and understand
        AI-powered work—while keeping execution close to the machines and accounts
        that make it possible.
      </p>
        <div class="actions">
          <Button href="https://app.conclaveax.com" label="Open Conclave AX" />
          <Button href="/how-it-works/" label="See how it works" variant="secondary" />
        </div>
      </div>
      <div class="architecture-card" aria-label="Conclave AX architecture">
        <div class="eyebrow">The simple picture</div>
        <p>Cloud coordinates. Host provides the machine. Workers provide capability.</p>
        <div class="flow">
          <ArchitectureNode label="Conclave AX" />
          <ArchitectureNode label="Conclave Cloud" />
          <ArchitectureNode label="Conclave Host" />
          <ArchitectureNode label="Worker" />
        </div>
      </div>
    </section>
  </Container>

  <Section>
    <Container>
      <SectionHeader
        eyebrow="Designed for real work"
        title="Less black box. More useful control."
        description="Your work stays organized in Workspaces and Projects. Progress, artifacts, findings, and verification become part of the result—not scattered afterthoughts."
      />
      <div class="cards">
        <FeatureCard title="Direct the work"><p>Describe the outcome. Conclave AX coordinates the steps and the people or Workers involved.</p></FeatureCard>
        <FeatureCard title="Keep capability close"><p>A Conclave Host runs on your machine and supervises the Workers you choose to use.</p></FeatureCard>
        <FeatureCard title="See what happened"><p>Inspect progress, evidence, artifacts, and usage without relying on a model's summary alone.</p></FeatureCard>
      </div>
    </Container>
  </Section>
</SiteLayout>
