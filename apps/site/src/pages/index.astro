---
import SiteLayout from "../layouts/SiteLayout.astro";
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import HeroSharedProject from "../components/HeroSharedProject.astro";
import ProjectMembersDiagram from "../components/ProjectMembersDiagram.astro";
import CredentialPrivacyDiagram from "../components/CredentialPrivacyDiagram.astro";
import ConversationContinuity from "../components/ConversationContinuity.astro";
import ProjectWorkstreamShowcase from "../components/ProjectWorkstreamShowcase.astro";
import WorkflowShowcase from "../components/WorkflowShowcase.astro";
import AudienceCards from "../components/AudienceCards.astro";
import WorkspaceQuickstart from "../components/WorkspaceQuickstart.astro";
---

<SiteLayout
  title="Conclave AX — Bring your people and AI together"
  description="Conclave AX gives families, friends, and teams one shared place to collaborate with AI. Create projects, share AI access without sharing credentials, and keep conversations in context."
>
  <!-- Hero Section -->
  <Container>
    <section class="hero" id="product">
      <div>
        <div class="eyebrow">SHARED AI WORKSPACE</div>
        <h1>Bring your people and AI together.</h1>
        <p class="lede">
          Conclave AX gives families, friends and teams one shared place to work with AI. Create projects together, share access to AI Workers without sharing credentials, keep conversations and work in context, and use powerful workflows when a problem needs more than one AI.
        </p>
        <div class="actions">
          <Button href="https://app.conclaveax.com" label="Open Conclave AX" />
          <Button href="/how-it-works/" label="See how it works" variant="secondary" />
        </div>

        <div class="trust-value-strip">
          <div class="trust-item">
            <span class="trust-icon">👥</span>
            <span>Shared projects</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon">✨</span>
            <span>Shared AI access</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon">🔒</span>
            <span>Private credentials</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon">💬</span>
            <span>Work together</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon">⚡</span>
            <span>Choose any Worker</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon">🔄</span>
            <span>Workflows when needed</span>
          </div>
        </div>
      </div>
      <HeroSharedProject />
    </section>
  </Container>

  <!-- Section 1: One Project. People + AI -->
  <Section>
    <Container>
      <div class="split-section">
        <div>
          <SectionHeader
            eyebrow="ONE PROJECT. PEOPLE + AI."
            title="Bring everyone's AI into the same project."
            description="Everyone doesn't need the same AI setup. Project members can contribute the AI Workers they choose to make available, while Conclave keeps access, credentials and usage controlled."
          />
          <div class="feature-bullets">
            <div class="bullet-item">
              <strong>Multi-Provider Freedom</strong>
              <p>Combine ChatGPT, Claude, Gemini, DeepSeek, or local models inside the same shared workspace.</p>
            </div>
            <div class="bullet-item">
              <strong>Equal Access for Everyone</strong>
              <p>All members of your project can query the shared AI workers without needing individual subscriptions.</p>
            </div>
            <div class="bullet-item">
              <strong>Complete Group Context</strong>
              <p>Responses, attachments, and follow-ups stay visible to everyone in the project.</p>
            </div>
          </div>
        </div>
        <ProjectMembersDiagram />
      </div>
    </Container>
  </Section>

  <!-- Section 2: Share Access. Keep Credentials Private -->
  <Section>
    <Container>
      <SectionHeader
        eyebrow="CREDENTIALS STAY PRIVATE"
        title="Share access. Keep credentials private."
        description="An AI Account stays owned by its owner. When it is shared with a project, members can use that AI capability for project work, but no one ever sees your API keys, tokens or login secrets. Permissions can be granted, scoped or revoked at any time."
      />
      <CredentialPrivacyDiagram />
    </Container>
  </Section>

  <!-- Section 3: Collaborative Conversations & Model Switching -->
  <Section>
    <Container>
      <div class="split-section split-section--reversed">
        <div>
          <SectionHeader
            eyebrow="COLLABORATION IN CONTEXT"
            title="One conversation. Everyone stays in context."
            description="Stop taking screenshots of chatbot answers or copying and pasting between tabs. In Conclave AX, everyone in the project sees the prompt, the AI response, the follow-up questions and the decisions being made."
          />
          <div class="feature-bullets">
            <div class="bullet-item">
              <strong>Change the AI, not the conversation</strong>
              <p>Need a different perspective or specialized capability? Switch between ChatGPT, Claude, Gemini or local models within the same conversation without losing the history of what you've already discussed.</p>
            </div>
            <div class="bullet-item">
              <strong>Shared turn history</strong>
              <p>Every turn retains citations, code blocks, and context so your whole group can iterate smoothly.</p>
            </div>
          </div>
        </div>
        <ConversationContinuity />
      </div>
    </Container>
  </Section>

  <!-- Section 4: Projects & Workstreams -->
  <Section id="workstreams">
    <Container>
      <SectionHeader
        eyebrow="ORGANIZATION"
        title="Keep every conversation focused."
        description="Separate major efforts into Projects, and divide complex topics into Workstreams. Keep your summer vacation separate from your home renovation, or your product research separate from your sprint backlog."
      />
      <ProjectWorkstreamShowcase />
    </Container>
  </Section>

  <!-- Section 5: Advanced Workflows -->
  <Section>
    <Container>
      <SectionHeader
        eyebrow="ADVANCED WORKFLOWS"
        title="When a chat isn't enough: Turn a question into a workflow."
        description="When a task needs more than a single prompt, run multi-step workflows. Coordinate multiple AI Workers to research, analyze, compare, draft, code or verify findings, giving you higher-quality results with full transparency."
      />
      <WorkflowShowcase />
    </Container>
  </Section>

  <!-- Section 6: Who It's For -->
  <Section id="use-cases">
    <Container>
      <SectionHeader
        eyebrow="BUILT FOR EVERY TEAM"
        title="Designed for how people actually collaborate."
        description="Whether you're organizing a family trip, leading product decisions with your team, or shipping verified code, Conclave AX brings people and AI into a unified collaboration layer."
      />
      <AudienceCards />
    </Container>
  </Section>

  <!-- Section 7: Power Users & Developers (Local Workspaces) -->
  <Section>
    <Container>
      <div class="workspace-section" data-site-event="section.workspace_reached">
        <div>
          <SectionHeader
            eyebrow="POWER USERS & DEVELOPERS"
            title="Connect local tools and machines when you need them."
            description="For engineering teams and technical users, Conclave Workspace connects your local computer, repositories, and command-line tools to your shared projects with isolated execution environments."
          />
          <p class="workspace-section__copy">
            Conclave AX works out of the box in your web browser. When you want to run coding agents on local codebases or run local test suites, simply download Conclave Workspace.
          </p>
          <div class="workspace-platforms">
            <span>macOS</span>
            <span>Windows</span>
            <span>Linux</span>
          </div>
          <div class="actions">
            <Button href="/downloads/" label="Download Conclave Workspace →" variant="secondary" />
          </div>
        </div>
        <WorkspaceQuickstart />
      </div>
    </Container>
  </Section>

  <!-- Final CTA Section -->
  <Section class="final-cta-section">
    <Container>
      <div class="final-cta">
        <SectionHeader
          eyebrow="AI IS BETTER TOGETHER"
          title="Bring your people and AI together."
          description="Create your first project in seconds. Invite your friends, family, or teammates, and collaborate with AI in one shared workspace."
        />
        <div class="final-cta__actions">
          <Button href="https://app.conclaveax.com" label="Open Conclave AX" />
          <Button href="/how-it-works/" label="See how it works" variant="secondary" />
        </div>
      </div>
    </Container>
  </Section>
</SiteLayout>
