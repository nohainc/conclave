---
import SiteLayout from "../layouts/SiteLayout.astro";
import Button from "../components/Button.astro";
import AccountPrivacyDiagram from "../components/AccountPrivacyDiagram.astro";
import Container from "../components/Container.astro";
import FeatureCard from "../components/FeatureCard.astro";
import HeroArchitecture from "../components/HeroArchitecture.astro";
import HostTopology from "../components/HostTopology.astro";
import HostQuickstart from "../components/HostQuickstart.astro";
import InteractiveWorkflow from "../components/InteractiveWorkflow.astro";
import IsolationModel from "../components/IsolationModel.astro";
import QualityFlow from "../components/QualityFlow.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import WorkerEcosystem from "../components/WorkerEcosystem.astro";
import WorkstreamModel from "../components/WorkstreamModel.astro";
---

<SiteLayout
  title="Conclave AX — Turn team decisions into verified AI work"
  description="Conclave AX gives teams a shared place to discuss work, run coordinated AI workflows, and inspect verified results across models and machines."
>
  <Container>
    <section class="hero" id="product">
      <div>
        <div class="eyebrow">Collaborative AI orchestration</div>
        <h1>Turn team decisions into verified AI work.</h1>
        <p class="lede">
          Conclave AX gives people one place to discuss a problem, deliberately start AI work,
          coordinate specialized models and tools, and inspect the result with tests, review,
          artifacts, and evidence.
        </p>
        <div class="actions">
          <Button href="https://app.conclaveax.com" label="Open Conclave AX" />
          <Button href="/how-it-works/" label="See how it works" variant="secondary" />
        </div>

        <div class="metrics-strip">
          <div class="metric-item">
            <strong>Human-controlled</strong>
            <span>Discussion never starts execution by itself.</span>
          </div>
          <div class="metric-item">
            <strong>Multi-model</strong>
            <span>Use different Workers for research, implementation, review, and verification.</span>
          </div>
          <div class="metric-item">
            <strong>Isolated execution</strong>
            <span>Parallel Workstreams keep mutable work from colliding.</span>
          </div>
        </div>
      </div>
      <HeroArchitecture />
    </section>
  </Container>

  <Section id="workstreams">
    <Container>
      <div class="split-section">
        <div>
          <SectionHeader
            eyebrow="Workstreams"
            title="Give every piece of work its own place."
            description="A Project brings people together. Workstreams keep each feature, investigation, or delivery thread focused, with human discussion and AI execution connected but deliberately separate."
          />
          <div class="quality-points">
            <span>Shared context</span><span>Discuss</span><span>Work Requests</span><span>Checkpoints</span><span>Clear ownership</span>
          </div>
        </div>
        <WorkstreamModel />
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <SectionHeader
        eyebrow="How teams work"
        title="Talk first. Run AI when the team is ready."
        description="Conclave separates collaboration from execution. People can challenge ideas, refine requirements, and agree on the next step without accidentally spending an AI Account or changing a repository."
      />
      <InteractiveWorkflow />
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="quality-section">
        <div>
          <SectionHeader
            eyebrow="Quality and verification"
            title="A result is more useful when you can inspect how it was produced."
            description="Workflows can combine specialized Workers, independent review, correction loops, tests, and evidence instead of relying on a single model response."
          />
          <div class="quality-points">
            <span>Role-based delegation</span><span>Independent review</span><span>Correction loops</span><span>Automated tests</span><span>Structured evidence</span>
          </div>
          <div class="actions">
            <Button href="/how-it-works/" label="Explore the workflow →" variant="secondary" />
          </div>
        </div>
        <QualityFlow />
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="split-section">
        <div>
          <SectionHeader
            eyebrow="Safe parallel work"
            title="Run multiple Workstreams without sharing one mutable folder."
            description="Each stateful Workstream uses its own managed checkout on a Primary Workspace. Different Workstreams can run in parallel, while mutating work inside one Workstream is serialized to keep the environment deterministic."
          />
          <p class="section-intro">The result is practical team concurrency without turning your development machine into a distributed merge problem.</p>
        </div>
        <IsolationModel />
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <SectionHeader
        eyebrow="Workers"
        title="Use the right AI or tool for each step."
        description="Connect coding agents, model APIs, local tools, and verification capabilities as Workers. Workflows request roles and capabilities; Conclave resolves eligible execution resources."
      />
      <WorkerEcosystem />
      <div class="actions">
        <Button href="/workers/" label="Explore Workers →" variant="secondary" />
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="host-section" data-site-event="section.workspace_reached">
        <div>
          <SectionHeader
            eyebrow="Workspaces"
            title="Bring execution to the machines you control."
            description="A Workspace represents one execution environment. It owns local Worker installations, repository access, runtime capacity, and local credential material."
          />
          <p class="host-section__copy">Projects do not inherit access to a machine. A Workspace is usable only through an explicit Project grant with bounded permissions.</p>
          <div class="host-platforms"><span>macOS</span><span>Windows</span><span>Linux</span></div>
          <div class="actions"><Button href="https://app.conclaveax.com" label="Open Conclave AX →" /></div>
        </div>
        <HostTopology />
      </div>
      <div style="margin-top: var(--space-8);">
        <HostQuickstart />
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="account-privacy-section">
        <div>
          <SectionHeader
            eyebrow="Accounts and privacy"
            title="Execution access and AI credentials are separate decisions."
            description="A Project may be allowed to use a Workspace without automatically receiving access to anyone's AI Account."
          />
          <ul class="privacy-points">
            <li>AI Accounts are private by default.</li>
            <li>Project sharing is explicit and revocable.</li>
            <li>Sharing authorizes use, not secret visibility.</li>
            <li>Usage remains attributable to the requester and Account owner.</li>
          </ul>
          <div class="actions"><Button href="/security/" label="Read about security →" variant="secondary" /></div>
        </div>
        <AccountPrivacyDiagram />
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <SectionHeader
        eyebrow="Built for individuals and teams"
        title="Useful when you work alone. More valuable when several people share the same project."
        description="Conclave keeps project collaboration, execution resources, AI Accounts, and work history separate enough to stay understandable as your team grows."
      />
      <div class="cards">
        <FeatureCard title="For individuals"><p>Keep complex work organized across Workstreams, reuse your machines and AI Accounts, and build a reliable history of what was tried and verified.</p></FeatureCard>
        <FeatureCard title="For teams"><p>Discuss together, control who can run AI work, share only the execution resources you intend to share, and avoid overlapping mutable environments.</p></FeatureCard>
        <FeatureCard title="For organizations"><p>Use explicit Project membership, scoped Workspace grants, auditable execution, account attribution, budgets, and repeatable workflows as the operating model expands.</p></FeatureCard>
      </div>
    </Container>
  </Section>

  <Section class="final-cta-section">
    <Container>
      <div class="final-cta">
        <SectionHeader eyebrow="Make AI work part of the team workflow" title="Discuss it. Run it. Verify it." description="Bring people, AI Workers, execution environments, and evidence together without turning everything into one opaque chat." />
        <div class="final-cta__actions">
          <Button href="https://app.conclaveax.com" label="Open Conclave AX" />
          <a href="/how-it-works/">See how it works <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </Container>
  </Section>
</SiteLayout>
