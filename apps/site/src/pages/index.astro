---
import SiteLayout from "../layouts/SiteLayout.astro";
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import FeatureCard from "../components/FeatureCard.astro";
import HeroArchitecture from "../components/HeroArchitecture.astro";
import PrincipleCard from "../components/PrincipleCard.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
---

<SiteLayout
  title="Conclave AX — AI work with a clear path to done"
  description="Conclave AX coordinates AI and tool work across your Workspace, Hosts, Workers, and Accounts."
>
  <Container>
    <section class="hero" id="product">
      <div>
        <div class="eyebrow">A clearer way to direct AI work</div>
        <h1>Build with a team of AI Workers.</h1>
        <p class="lede">
          Conclave AX coordinates AI models and tools to research, plan, implement,
          review, test, and verify complex work.
        </p>
        <div class="actions">
          <Button href="https://app.conclaveax.com" label="Open Conclave AX" />
          <Button href="/how-it-works/" label="See how it works" variant="secondary" />
        </div>
      </div>
      <HeroArchitecture />
    </section>
  </Container>

  <Section>
    <Container>
      <SectionHeader
        eyebrow="Why Conclave AX"
        title="Complex work needs more than one answer."
        description="One large AI request often produces inconsistent quality. Conclave AX breaks complex goals into smaller work, assigns the right Workers, checks results independently, and iterates until the goal is verified."
      />
      <div class="principles">
        <PrincipleCard title="Delegate">
          <p>Give focused work to the right capability.</p>
          <div class="principle-list"><span>Research</span><span>Implementation</span><span>Testing</span><span>Review</span></div>
        </PrincipleCard>
        <PrincipleCard title="Compare">
          <p>Use independent perspectives when quality matters.</p>
          <div class="principle-compare"><span>Worker A</span><span>Worker B</span><span>Worker C</span></div>
        </PrincipleCard>
        <PrincipleCard title="Verify">
          <p>Make the result inspectable, not just plausible.</p>
          <div class="principle-list"><span>Tests</span><span>Reviews</span><span>Evidence</span><span>Artifacts</span></div>
        </PrincipleCard>
        <PrincipleCard title="Iterate">
          <p>Turn findings into corrections and check again.</p>
          <div class="principle-iterate"><span>Finding</span><i aria-hidden="true">↓</i><span>Correction</span><i aria-hidden="true">↓</i><span>Reverification</span></div>
        </PrincipleCard>
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <SectionHeader
        eyebrow="Designed for real work"
        title="Less black box. More useful control."
        description="Your work stays organized in Workspaces and Projects. Progress, artifacts, findings, and verification become part of the result—not scattered afterthoughts."
      />
      <div class="cards">
        <FeatureCard title="Direct the work"><p>Describe the outcome. Conclave AX coordinates the steps and the people or Workers involved.</p></FeatureCard>
        <FeatureCard title="Keep capability close"><p>A Conclave Host runs on your machine and supervises the Workers you choose to use.</p></FeatureCard>
        <FeatureCard title="See what happened"><p>Inspect progress, evidence, artifacts, and usage without relying on a model's summary alone.</p></FeatureCard>
      </div>
    </Container>
  </Section>
</SiteLayout>
