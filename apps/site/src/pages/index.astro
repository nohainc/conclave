---
import SiteLayout from "../layouts/SiteLayout.astro";
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import HeroSharedSpace from "../components/HeroSharedSpace.astro";
import SpaceMembersDiagram from "../components/SpaceMembersDiagram.astro";
import CredentialPrivacyDiagram from "../components/CredentialPrivacyDiagram.astro";
import ConversationContinuity from "../components/ConversationContinuity.astro";
import SpaceThreadShowcase from "../components/SpaceThreadShowcase.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import WorkflowShowcase from "../components/WorkflowShowcase.astro";
import AudienceCards from "../components/AudienceCards.astro";
import WorkspaceQuickstart from "../components/WorkspaceQuickstart.astro";
---

<SiteLayout
  title="Conclave AX — Bring your people and AI together"
  description="Conclave AX gives families, friends, and teams one shared place to collaborate with AI. Create spaces, share AI access without sharing credentials, and keep conversations in context."
>
  <!-- Hero Section -->
  <Container>
    <section class="hero" id="product">
      <div>
        <div class="eyebrow">SHARED AI WORKSPACE</div>
        <h1>Bring your people and AI together.</h1>
        <p class="lede">
          A shared workspace where families, friends and teams can work with AI together. Bring AI Workers into shared spaces, collaborate in the same conversations, and keep credentials private.
        </p>
        <div class="actions">
          <Button href="https://app.conclaveax.com" label="Open Conclave AX" />
          <Button href="/how-it-works/" label="See how it works" variant="secondary" />
        </div>

        <div class="trust-value-strip">
          <div class="trust-item">
            <span class="trust-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </span>
            <span>Shared spaces</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3z"/></svg>
            </span>
            <span>Shared AI access</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </span>
            <span>Private credentials</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </span>
            <span>Work together</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </span>
            <span>Choose any Worker</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
            </span>
            <span>Workflows when needed</span>
          </div>
        </div>
      </div>
      <HeroSharedSpace />
    </section>
  </Container>

  <!-- Section 1: Mental Model - One space. Your people. Their AI. -->
  <Section>
    <Container>
      <SectionHeader
        eyebrow="ONE SPACE. PEOPLE + AI."
        title="One space. Your people. Their AI."
        description="Everyone doesn't need the same AI setup. Space members can make their supported AI Workers available to the space, while Conclave keeps access, credentials and usage securely controlled."
      />
      <SpaceMembersDiagram />
    </Container>
  </Section>

  <!-- Section 2: Collaborative Conversations -->
  <Section>
    <Container>
      <div class="split-section split-section--reversed">
        <div>
          <SectionHeader
            eyebrow="COLLABORATION IN CONTEXT"
            title="One conversation. Everyone stays in context."
            description="AI stops being an isolated chat between one person and a bot. In Conclave AX, everyone in the space sees the prompt, the AI response, the follow-up questions and the decisions being made."
          />
          <div class="feature-bullets">
            <div class="bullet-item">
              <strong>Change the AI, not the conversation</strong>
              <p>Need a different perspective or specialized capability? Switch between authorized Workers in the same Thread without losing the history of what you've already discussed.</p>
            </div>
            <div class="bullet-item">
              <strong>Shared turn history</strong>
              <p>Every turn retains citations, code blocks, tables, and decisions so your whole group iterates smoothly together.</p>
            </div>
          </div>
        </div>
        <ConversationContinuity />
      </div>
    </Container>
  </Section>

  <!-- Section 3: Share Access. Keep Credentials Private -->
  <Section>
    <Container>
      <SectionHeader
        eyebrow="CREDENTIALS STAY PRIVATE"
        title="Share access. Keep credentials private."
        description="When you make an AI Worker available to a space, members can use that AI capability for space work, but no one ever sees your API keys, tokens or login secrets. Permissions can be granted, scoped or revoked at any time."
      />
      <CredentialPrivacyDiagram />
    </Container>
  </Section>

  <!-- Section 4: Spaces & Threads -->
  <Section id="threads">
    <Container>
      <SectionHeader
        eyebrow="ORGANIZATION"
        title="Keep every conversation focused."
        description="Separate major efforts into Spaces, and divide complex topics into Threads. Keep your vacation planning separate from your household budget, or your product research separate from your sprint backlog."
      />
      <SpaceThreadShowcase />
    </Container>
  </Section>

  <!-- Section 5: Comparison - Why not normal AI chat? -->
  <Section>
    <Container>
      <SectionHeader
        eyebrow="THE COLLABORATION DIFFERENCE"
        title="AI chat was designed for one person. Conclave is designed for a group."
        description="Traditional AI chatbots trap prompts, answers, and subscriptions in individual browser tabs. Conclave AX creates a shared collaboration layer where teams think and decide together."
      />
      <ComparisonTable />
    </Container>
  </Section>

  <!-- Section 6: Advanced Workflows -->
  <Section>
    <Container>
      <SectionHeader
        eyebrow="ADVANCED WORKFLOWS"
        title="When a chat isn't enough: Turn a question into a workflow."
        description="When a task needs more than a single prompt, run multi-step workflows. Coordinate multiple AI Workers to research, analyze, compare, draft, code or verify findings, giving you higher-quality results with full transparency."
      />
      <WorkflowShowcase />
    </Container>
  </Section>

  <!-- Section 7: Who It's For -->
  <Section id="use-cases">
    <Container>
      <SectionHeader
        eyebrow="BUILT FOR EVERY GROUP"
        title="Designed for how people actually collaborate."
        description="Whether you're organizing a family trip, leading product decisions with your team, or shipping verified code, Conclave AX brings people and AI into a unified collaboration layer."
      />
      <AudienceCards />
    </Container>
  </Section>

  <!-- Section 8: Power Users & Developers (Local Workspaces) -->
  <Section>
    <Container>
      <div class="workspace-section" data-site-event="section.workspace_reached">
        <div>
          <SectionHeader
            eyebrow="POWER USERS & DEVELOPERS"
            title="Connect local tools and machines when you need them."
            description="For engineering teams and technical users, Conclave Workspace connects your local computer, repositories, and command-line tools to your shared spaces with isolated execution environments."
          />
          <p class="workspace-section__copy">
            Conclave AX works out of the box in your web browser. When you want to run coding agents on local codebases or run local test suites, simply download Conclave Workspace.
          </p>
          <div class="workspace-platforms">
            <span>macOS</span>
            <span>Windows</span>
            <span>Linux</span>
          </div>
          <div class="actions">
            <Button href="/downloads/" label="Download Conclave Workspace →" variant="secondary" />
          </div>
        </div>
        <WorkspaceQuickstart />
      </div>
    </Container>
  </Section>

  <!-- Final CTA Section -->
  <Section class="final-cta-section">
    <Container>
      <div class="final-cta">
        <SectionHeader
          eyebrow="AI IS BETTER TOGETHER"
          title="Bring your people and AI together."
          description="Create your first space in seconds. Invite your friends, family, or teammates, and collaborate with AI in one shared workspace."
        />
        <div class="final-cta__actions">
          <Button href="https://app.conclaveax.com" label="Open Conclave AX" />
          <Button href="/how-it-works/" label="See how it works" variant="secondary" />
        </div>
      </div>
    </Container>
  </Section>
</SiteLayout>
