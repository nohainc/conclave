---
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import CredentialPrivacyDiagram from "../components/CredentialPrivacyDiagram.astro";
---

<SiteLayout
  title="AI & Workers — Conclave AX"
  description="Connect ChatGPT, Claude, Gemini, DeepSeek, local LLMs, and coding agents to your shared Conclave projects."
>
  <Section>
    <Container>
      <SectionHeader
        eyebrow="AI & Workers"
        title="Connect and share your favorite AI models."
        description="Conclave AX lets team members contribute their preferred AI models and tools to shared projects. Use any model directly in team conversations or orchestrate them across automated workflows."
        headingLevel={1}
      />

      <div class="cards worker-catalog" data-site-event="section.workers_reached">
        <FeatureCard title="ChatGPT & OpenAI" headingLevel={2}>
          <p>Connect your OpenAI account or ChatGPT subscription for structured reasoning, synthesis, brainstorming, and general knowledge tasks.</p>
        </FeatureCard>

        <FeatureCard title="Claude & Anthropic" headingLevel={2}>
          <p>Connect Anthropic accounts for deep document analysis, long-form writing, strategic nuance, and comprehensive code review.</p>
        </FeatureCard>

        <FeatureCard title="Google Gemini" headingLevel={2}>
          <p>Connect Google AI accounts for massive context window analysis, high-speed research synthesis, and multimodal processing.</p>
        </FeatureCard>

        <FeatureCard title="DeepSeek & Open Models" headingLevel={2}>
          <p>Integrate DeepSeek and open weights models for math, logic, rapid prototyping, and specialized coding benchmarks.</p>
        </FeatureCard>

        <FeatureCard title="Coding Agents (CLI)" headingLevel={2}>
          <p>Run Codex and Claude Code CLI through your connected Workspace for direct repository implementation and automated testing.</p>
        </FeatureCard>

        <FeatureCard title="Local & Private LLMs" headingLevel={2}>
          <p>Connect Ollama or local LLM instances running on your own hardware for private, offline, zero-cloud-telemetry execution.</p>
        </FeatureCard>
      </div>

      <div style="margin-top: var(--space-16);">
        <SectionHeader
          eyebrow="Security & Sharing"
          title="Share AI access without sharing your secrets."
          description="Every AI account remains owned and controlled by the person who connected it. When you share an AI worker with a project, collaborators can prompt the model, but they can never view your API keys or passwords."
        />
        <CredentialPrivacyDiagram />
      </div>

      <div class="actions" style="justify-content: center; margin-top: var(--space-16);">
        <Button href="https://app.conclaveax.com" label="Open Conclave AX" />
        <Button href="/downloads/" label="Download Workspace for local tools" variant="secondary" />
      </div>
    </Container>
  </Section>
</SiteLayout>
