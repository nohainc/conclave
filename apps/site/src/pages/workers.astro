---
import Container from "../components/Container.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Workers — Conclave AX" description="Workers connect Conclave AX to AI models, coding tools, local capabilities, and verification systems.">
  <Section>
    <Container>
      <SectionHeader eyebrow="Workers" title="Treat models and tools as capabilities, not as the whole workflow." description="Workers let Conclave AX use AI models, coding tools, CLIs, test tools, and other integrations. A workflow asks for the role and capability it needs; Conclave resolves an eligible Worker at execution time." headingLevel={1} />

      <div class="cards worker-catalog" data-site-event="section.workers_reached">
        <FeatureCard title="Codex" headingLevel={2}><p>Repository-aware implementation and coding work through a Workspace-managed Worker.</p></FeatureCard>
        <FeatureCard title="Claude Code" headingLevel={2}><p>Implementation, analysis, review, and codebase investigation through a specialized Worker.</p></FeatureCard>
        <FeatureCard title="OpenAI" headingLevel={2}><p>API-backed model execution for research, synthesis, structured reasoning, and workflow tasks.</p></FeatureCard>
        <FeatureCard title="Anthropic" headingLevel={2}><p>API-backed model execution for analysis, research, review, and structured assignments.</p></FeatureCard>
      </div>

      <div class="worker-account-model">
        <div>
          <SectionHeader eyebrow="Worker lifecycle" title="Install capability once. Authorize use separately." description="Workers belong to a Workspace runtime. AI Accounts belong to people and are authorized independently for Project work." />
          <ul class="privacy-points">
            <li>Workspace owners control which Workers are installed and enabled.</li>
            <li>Projects can use only Workers permitted by their Workspace grants.</li>
            <li>AI Account authorization remains independent from Worker availability.</li>
            <li>Assignments snapshot the Worker, Account, permissions, and execution context used.</li>
          </ul>
        </div>
        <div class="account-tree" aria-label="Worker and Account separation">
          <strong>Implementation workflow</strong>
          <span class="account-tree__line" aria-hidden="true">│</span>
          <span>├── Role: implement</span>
          <span>├── Worker: eligible coding capability</span>
          <span>├── Workspace: authorized execution environment</span>
          <span>└── Account: independently authorized identity</span>
        </div>
      </div>
    </Container>
  </Section>
</SiteLayout>
