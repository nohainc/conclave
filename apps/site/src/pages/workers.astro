---
import Container from "../components/Container.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Workers — Conclave AX" description="Workers are installable AI and tool capabilities managed by Conclave Host.">
  <Section>
    <Container>
      <SectionHeader eyebrow="Workers" title="Choose capability, not a permanent machine identity." description="Workers are installable integrations that a Host can supervise. The same Worker can serve different Projects and Accounts while each assignment keeps its own context." />
    <div class="cards">
      <FeatureCard title="AI and coding"><p>Connect the AI and coding capabilities your work needs through the Worker catalog.</p></FeatureCard>
      <FeatureCard title="Automatic updates"><p>Conclave Host resolves, verifies, installs, health-checks, and rolls back Worker versions.</p></FeatureCard>
      <FeatureCard title="Account-aware execution"><p>Accounts keep external AI identity separate from shared Worker software.</p></FeatureCard>
    </div>
    </Container>
  </Section>
</SiteLayout>
