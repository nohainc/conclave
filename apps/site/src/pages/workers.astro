---
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import CredentialPrivacyDiagram from "../components/CredentialPrivacyDiagram.astro";
---

<SiteLayout
  title="AI & Workers — Conclave AX"
  description="Connect ChatGPT, Claude, Gemini, DeepSeek, local LLMs, and coding agents to your shared Conclave spaces."
>
  <Section>
    <Container>
      <SectionHeader
        eyebrow="AI & Workers"
        title="Connect and share your favorite AI models."
        description="Conclave AX lets team members contribute their preferred AI models and tools to shared spaces. Use any model directly in team conversations or orchestrate them across automated workflows."
        headingLevel={1}
      />

      <div class="cards worker-catalog" data-site-event="section.workers_reached">
        <FeatureCard title="ChatGPT & OpenAI (Supported)" headingLevel={2}>
          <p>Connect your OpenAI account for structured reasoning, synthesis, brainstorming, and general knowledge tasks in shared spaces.</p>
        </FeatureCard>

        <FeatureCard title="Google Gemini (Supported)" headingLevel={2}>
          <p>Connect Google AI accounts for massive context window analysis, high-speed research synthesis, and multimodal processing.</p>
        </FeatureCard>

        <FeatureCard title="Coding Agents (Supported CLI Engine)" headingLevel={2}>
          <p>Run Codex CLI through your connected Workspace for direct repository implementation and automated testing on your hardware.</p>
        </FeatureCard>

        <FeatureCard title="Claude & Anthropic (Planned)" headingLevel={2}>
          <p>Planned support for Anthropic accounts for deep document analysis, strategic nuance, and comprehensive code review.</p>
        </FeatureCard>

        <FeatureCard title="DeepSeek & Open Models (Planned)" headingLevel={2}>
          <p>Planned support for DeepSeek and open-weights models for math, logic, rapid prototyping, and specialized coding benchmarks.</p>
        </FeatureCard>

        <FeatureCard title="Local & Private LLMs (Planned)" headingLevel={2}>
          <p>Planned support for Ollama and local LLM instances running on your own hardware for private, offline execution.</p>
        </FeatureCard>
      </div>

      <div style="margin-top: var(--space-16);">
        <SectionHeader
          eyebrow="Security & Sharing"
          title="Share AI access without sharing your secrets."
          description="Every AI account remains owned and controlled by the person who connected it. When you share an AI worker with a space, collaborators can prompt the model, but they can never view your API keys or passwords."
        />
        <CredentialPrivacyDiagram />
      </div>

      <div class="actions" style="justify-content: center; margin-top: var(--space-16);">
        <Button href="https://app.conclaveax.com" label="Open Conclave AX" />
        <Button href="/downloads/" label="Download Workspace for local tools" variant="secondary" />
      </div>
    </Container>
  </Section>
</SiteLayout>
