---
import Container from "../components/Container.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Workers — Conclave AX" description="Workers are installable AI and tool capabilities managed by Conclave Host.">
  <Section>
    <Container>
      <SectionHeader eyebrow="Workers" title="Choose capability, not a permanent machine identity." description="A Worker is an integration that lets Conclave AX use an AI model, CLI, or tool. Workers are installed on Hosts and selected for individual assignments." headingLevel={1} />
      <div class="cards worker-catalog">
        <FeatureCard title="Codex"><p>AI coding and repository work through a Host-managed Worker.</p></FeatureCard>
        <FeatureCard title="Claude Code"><p>AI-assisted coding and review for focused implementation work.</p></FeatureCard>
        <FeatureCard title="OpenAI"><p>API-backed model execution for structured assignments.</p></FeatureCard>
        <FeatureCard title="Anthropic"><p>API-backed model execution for structured assignments.</p></FeatureCard>
      </div>
      <p class="catalog-note">More Workers coming as integrations become ready for the catalog.</p>
      <div class="worker-account-model">
        <div>
          <SectionHeader eyebrow="One installation, many assignments" title="Software is shared. Accounts stay separate." description="A Worker is installed once on a Host and can serve different user Accounts without turning the installation into an identity." />
        </div>
        <div class="account-tree" aria-label="Codex Worker connected to separate Accounts">
          <strong>Codex Worker</strong>
          <span class="account-tree__line" aria-hidden="true">│</span>
          <span>├── Vitalii Account</span>
          <span>├── Alice Account</span>
          <span>└── Team Account</span>
        </div>
      </div>
    </Container>
  </Section>
</SiteLayout>
