---
// Component: ComparisonTable
// Compact comparison table between Traditional AI Chat and Conclave AX
---

<div class="comparison-container">
  <div class="comparison-table-wrapper">
    <table class="comparison-table">
      <caption class="visually-hidden">Comparison between Traditional AI Chat and Conclave AX</caption>
      <thead>
        <tr>
          <th scope="col" class="th-feature">Capability</th>
          <th scope="col" class="th-traditional">Traditional AI Chat</th>
          <th scope="col" class="th-conclave">
            <span class="conclave-badge">Conclave AX</span>
          </th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row" class="td-feature">
            <strong>Audience</strong>
          </th>
          <td class="td-traditional">One person in isolation</td>
          <td class="td-conclave">
            <strong>A collaborative group</strong>
            <small>Families, friends, and teams together</small>
          </td>
        </tr>
        <tr>
          <th scope="row" class="td-feature">
            <strong>AI Resources</strong>
          </th>
          <td class="td-traditional">Single personal subscription or key</td>
          <td class="td-conclave">
            <strong>AI Workers contributed by members</strong>
            <small>ChatGPT, Gemini, Claude, or local tools</small>
          </td>
        </tr>
        <tr>
          <th scope="row" class="td-feature">
            <strong>Context & History</strong>
          </th>
          <td class="td-traditional">Siloed in separate browser tabs</td>
          <td class="td-conclave">
            <strong>Shared space & Thread history</strong>
            <small>Everyone stays aligned on decisions</small>
          </td>
        </tr>
        <tr>
          <th scope="row" class="td-feature">
            <strong>Collaboration</strong>
          </th>
          <td class="td-traditional">Copying and pasting screenshots</td>
          <td class="td-conclave">
            <strong>Continue the same conversation</strong>
            <small>Anyone can ask follow-ups in place</small>
          </td>
        </tr>
        <tr>
          <th scope="row" class="td-feature">
            <strong>Multi-Model</strong>
          </th>
          <td class="td-traditional">Switch apps and repeat prompt context</td>
          <td class="td-conclave">
            <strong>Switch Worker in the Thread</strong>
            <small>Context is preserved automatically</small>
          </td>
        </tr>
        <tr>
          <th scope="row" class="td-feature">
            <strong>Credentials & Privacy</strong>
          </th>
          <td class="td-traditional">Tied directly to an individual login</td>
          <td class="td-conclave">
            <strong>Controlled Worker access</strong>
            <small>Credentials stay private to their owner</small>
          </td>
        </tr>
        <tr>
          <th scope="row" class="td-feature">
            <strong>Execution</strong>
          </th>
          <td class="td-traditional">One prompt and response at a time</td>
          <td class="td-conclave">
            <strong>Optional multi-step workflows</strong>
            <small>Coordinate research, analysis, and execution</small>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
