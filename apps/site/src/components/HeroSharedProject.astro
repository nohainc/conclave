---
// Component: HeroSharedProject
// Displays a realistic mockup of Conclave AX shared AI workspace
---

<div class="hero-project-mockup" aria-label="Conclave AX shared project interface mockup">
  <!-- Window Header / Title Bar -->
  <div class="mockup-header">
    <div class="mockup-header__left">
      <div class="window-dots" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <div class="project-identity">
        <span class="project-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/></svg>
        </span>
        <strong class="project-name">Family Vacation</strong>
        <span class="project-badge">3 members</span>
      </div>
    </div>
    <div class="mockup-header__right">
      <div class="member-avatars" aria-label="Project members">
        <span class="avatar avatar--vitalii" title="Vitalii (Owner)">V</span>
        <span class="avatar avatar--julia" title="Julia">J</span>
        <span class="avatar avatar--erik" title="Erik">E</span>
      </div>
      <button type="button" class="invite-btn" tabindex="-1" aria-hidden="true">+ Invite</button>
    </div>
  </div>

  <!-- Workspace Main Layout (Sidebar + Chat Area) -->
  <div class="mockup-body">
    <!-- Sidebar / Context -->
    <div class="mockup-sidebar">
      <div class="sidebar-section">
        <span class="sidebar-title">Workstreams</span>
        <div class="workstream-list">
          <div class="ws-item is-active">
            <span class="ws-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </span>
            <span class="ws-name">Prague or Vienna?</span>
            <span class="ws-badge">Live</span>
          </div>
          <div class="ws-item">
            <span class="ws-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </span>
            <span class="ws-name">Hotels & Apartments</span>
          </div>
          <div class="ws-item">
            <span class="ws-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </span>
            <span class="ws-name">Activities for Erik</span>
          </div>
          <div class="ws-item">
            <span class="ws-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <span class="ws-name">Budget & Flights</span>
          </div>
        </div>
      </div>

      <div class="sidebar-section">
        <span class="sidebar-title">Members</span>
        <div class="members-mini-list">
          <div class="member-mini-row">
            <span class="avatar avatar--vitalii avatar--small">V</span>
            <span>Vitalii</span>
            <small class="member-role">Owner</small>
          </div>
          <div class="member-mini-row">
            <span class="avatar avatar--julia avatar--small">J</span>
            <span>Julia</span>
            <small class="member-role">Editor</small>
          </div>
          <div class="member-mini-row">
            <span class="avatar avatar--erik avatar--small">E</span>
            <span>Erik</span>
            <small class="member-role">Viewer</small>
          </div>
        </div>
      </div>

      <div class="sidebar-section">
        <span class="sidebar-title">AI Workers in Project</span>
        <div class="ai-worker-pills">
          <div class="ai-pill">
            <span class="ai-dot ai-dot--chatgpt"></span>
            <span>ChatGPT</span>
            <small class="ai-owner">Vitalii</small>
          </div>
          <div class="ai-pill">
            <span class="ai-dot ai-dot--gemini"></span>
            <span>Gemini</span>
            <small class="ai-owner">Julia</small>
          </div>
          <div class="ai-pill">
            <span class="ai-dot ai-dot--claude"></span>
            <span>Claude</span>
            <small class="ai-owner">Erik</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Active Conversation View -->
    <div class="mockup-chat">
      <div class="chat-header">
        <div class="chat-header__title">
          <span class="ws-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </span>
          <strong>Prague or Vienna for Christmas?</strong>
        </div>
        <span class="chat-header__status">● 3 active in workstream</span>
      </div>

      <div class="chat-messages">
        <!-- Message 1: Vitalii -->
        <div class="chat-bubble chat-bubble--user">
          <div class="chat-bubble__meta">
            <span class="avatar avatar--vitalii avatar--small">V</span>
            <strong>Vitalii</strong>
            <span class="timestamp">10:42 AM</span>
          </div>
          <p>Compare Prague vs Vienna for our family Christmas trip with kids. Which city is better for walking and holiday atmosphere?</p>
        </div>

        <!-- Message 2: ChatGPT response -->
        <div class="chat-bubble chat-bubble--ai">
          <div class="chat-bubble__meta">
            <span class="ai-tag ai-tag--chatgpt">◉ ChatGPT</span>
            <span class="ai-via">via Vitalii's AI</span>
            <span class="timestamp">10:42 AM</span>
          </div>
          <p>Vienna features the Christkindlmarkt at Rathausplatz with ice trails, wide stroller-friendly avenues, and seamless public transit. Prague has the fairy-tale Old Town Square, but cobblestones and hills can be steeper for children.</p>
        </div>

        <!-- Message 3: Julia -->
        <div class="chat-bubble chat-bubble--user">
          <div class="chat-bubble__meta">
            <span class="avatar avatar--julia avatar--small">J</span>
            <strong>Julia</strong>
            <span class="timestamp">10:44 AM</span>
          </div>
          <p>What about interactive museum activities in Vienna for Erik?</p>
        </div>

        <!-- Message 4: Gemini response -->
        <div class="chat-bubble chat-bubble--ai">
          <div class="chat-bubble__meta">
            <span class="ai-tag ai-tag--gemini">◈ Gemini</span>
            <span class="ai-via">via Julia's AI</span>
            <span class="timestamp">10:44 AM</span>
          </div>
          <p>Vienna has the <strong>ZOOM Children's Museum</strong> in MuseumsQuartier and the <strong>Haus der Musik</strong> interactive sound experience, plus the Schönbrunn Palace maze.</p>
        </div>
      </div>

      <!-- Composer with Worker Selector -->
      <div class="mockup-composer">
        <div class="composer-input" aria-label="Ask the project">
          <span>Ask together in this Workstream...</span>
        </div>
        <div class="composer-toolbar">
          <div class="composer-selectors">
            <div class="selector-badge">
              <span class="ai-dot ai-dot--chatgpt"></span>
              <strong>ChatGPT</strong>
              <span class="selector-arrow">▾</span>
            </div>
            <div class="selector-badge selector-badge--subtle">
              <span>Auto model</span>
              <span class="selector-arrow">▾</span>
            </div>
            <div class="selector-badge selector-badge--subtle">
              <span>Medium effort</span>
              <span class="selector-arrow">▾</span>
            </div>
          </div>
          <button type="button" class="composer-send" tabindex="-1" aria-hidden="true">
            <span>Send</span>
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
