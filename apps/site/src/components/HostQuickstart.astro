---
import Button from "./Button.astro";
---

<div class="host-quickstart-card" aria-label="Add an execution Workspace">
  <div class="host-quickstart-header">
    <strong>Bring a machine into Conclave without turning it into a team container.</strong>
  </div>
  <div class="host-quickstart-steps">
    <div class="host-quickstart-step">
      <span class="host-step-num">1</span>
      <div><strong>Open Conclave AX</strong><p>Sign in and open Workspaces under execution resources.</p></div>
    </div>
    <div class="host-quickstart-step">
      <span class="host-step-num">2</span>
      <div><strong>Add a Workspace</strong><p>Create an execution environment for a machine you control.</p></div>
    </div>
    <div class="host-quickstart-step">
      <span class="host-step-num">3</span>
      <div><strong>Pair the machine</strong><p>Connect the Workspace runtime securely and choose the Workers you want available.</p></div>
    </div>
    <div class="host-quickstart-step">
      <span class="host-step-num">4</span>
      <div><strong>Grant it to a Project</strong><p>Projects can use the Workspace only through explicit, scoped execution access.</p></div>
    </div>
  </div>
  <div class="host-quickstart-cta">
    <Button href="https://app.conclaveax.com" label="Open Conclave AX →" />
  </div>
</div>
