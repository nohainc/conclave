---
// Component: ProjectMembersDiagram
// Visualizes members bringing different AI accounts into a shared Conclave project
---

<div class="project-members-diagram" aria-label="Diagram showing team members contributing AI accounts to a shared project">
  <div class="contributor-column">
    <div class="contributor-card">
      <div class="contributor-person">
        <span class="avatar avatar--vitalii">V</span>
        <div class="person-info">
          <strong>Vitalii</strong>
          <small>Team Member</small>
        </div>
      </div>
      <div class="contributed-arrow">→</div>
      <div class="contributed-ai ai-pill--chatgpt">
        <span class="ai-dot ai-dot--chatgpt"></span>
        <span>ChatGPT Plus</span>
      </div>
    </div>

    <div class="contributor-card">
      <div class="contributor-person">
        <span class="avatar avatar--julia">J</span>
        <div class="person-info">
          <strong>Julia</strong>
          <small>Team Member</small>
        </div>
      </div>
      <div class="contributed-arrow">→</div>
      <div class="contributed-ai ai-pill--gemini">
        <span class="ai-dot ai-dot--gemini"></span>
        <span>Gemini Advanced</span>
      </div>
    </div>

    <div class="contributor-card">
      <div class="contributor-person">
        <span class="avatar avatar--alex">A</span>
        <div class="person-info">
          <strong>Alex</strong>
          <small>Team Member</small>
        </div>
      </div>
      <div class="contributed-arrow">→</div>
      <div class="contributed-ai ai-pill--claude">
        <span class="ai-dot ai-dot--claude"></span>
        <span>Claude Pro</span>
      </div>
    </div>
  </div>

  <div class="diagram-hub">
    <div class="hub-line-group" aria-hidden="true">
      <div class="hub-line"></div>
      <div class="hub-line"></div>
      <div class="hub-line"></div>
    </div>
    <div class="hub-box">
      <div class="hub-badge">Conclave Shared Project</div>
      <strong>One Shared Workspace</strong>
      <p>Zero credential exposure · Full usage attribution</p>
      <div class="hub-perks">
        <span>✓ Shared history</span>
        <span>✓ Unified context</span>
        <span>✓ Any member can query</span>
      </div>
    </div>
  </div>
</div>
