<div class="isolation-model" aria-label="Two Threads executing safely in separate ID-derived directories on one Workspace">
  <div class="isolation-model__workspace">
    <div>
      <span>Primary Workspace</span>
      <strong>MacBook Pro</strong>
    </div>
    <span class="isolation-model__online">Online</span>
  </div>

  <div class="isolation-model__grid">
    <div class="isolation-card">
      <div class="isolation-card__top">
        <span>Thread A</span>
        <strong>Authentication</strong>
      </div>
      <div class="isolation-card__directory">Thread directory A</div>
      <div class="isolation-card__run"><i></i> Implementation running</div>
    </div>

    <div class="isolation-card">
      <div class="isolation-card__top">
        <span>Thread B</span>
        <strong>Scheduler</strong>
      </div>
      <div class="isolation-card__directory">Thread directory B</div>
      <div class="isolation-card__run"><i></i> Tests running</div>
    </div>
  </div>

  <div class="isolation-model__note">
    Different Threads can run in parallel. Mutating work inside one Thread is serialized.
  </div>
</div>