<div class="workstream-model" aria-label="A Project containing a Workstream with Discuss and Work lanes">
  <div class="workstream-model__project">
    <div class="workstream-model__label">Project</div>
    <strong>Product launch</strong>
    <span>People, context, access, history</span>
  </div>

  <div class="workstream-model__connector" aria-hidden="true">↓</div>

  <div class="workstream-model__workstream">
    <div class="workstream-model__header">
      <div>
        <div class="workstream-model__label">Workstream</div>
        <strong>Authentication redesign</strong>
      </div>
      <span class="workstream-model__status">Active</span>
    </div>

    <div class="workstream-model__lanes">
      <div class="workstream-lane">
        <span class="workstream-lane__eyebrow">Discuss</span>
        <strong>People decide what should change.</strong>
        <p>Share context, challenge ideas, and agree on the next step without triggering execution.</p>
      </div>
      <div class="workstream-lane workstream-lane--work">
        <span class="workstream-lane__eyebrow">Work</span>
        <strong>AI executes only when someone presses Run.</strong>
        <p>Choose a workflow, follow progress, inspect changes, tests, review, and evidence.</p>
      </div>
    </div>
  </div>
</div>