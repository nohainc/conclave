---
// Component: ProjectWorkstreamShowcase
// Demonstrates how Projects organize major initiatives and Workstreams keep topics focused
---

<div class="projects-workstreams-grid" aria-label="Examples of Project and Workstream organization">
  <!-- Card 1: Friends & Family -->
  <div class="project-showcase-card">
    <div class="project-card-badge">Family & Household</div>
    <div class="project-card-header">
      <span class="project-card-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      </span>
      <div>
        <h3>Home & Vacation Planning</h3>
        <span class="project-members-count">4 members · ChatGPT & Gemini</span>
      </div>
    </div>
    <div class="workstream-sublist">
      <div class="ws-mini-item ws-mini-item--active">
        <span class="ws-mini-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </span>
        <div class="ws-mini-text">
          <strong>Summer Vacation in Japan</strong>
          <small>Hotels, itinerary, bullet train transit</small>
        </div>
      </div>
      <div class="ws-mini-item">
        <span class="ws-mini-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </span>
        <div class="ws-mini-text">
          <strong>Kitchen Remodel Contractor Comparison</strong>
          <small>Quotes, material specs, timelines</small>
        </div>
      </div>
      <div class="ws-mini-item">
        <span class="ws-mini-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </span>
        <div class="ws-mini-text">
          <strong>Monthly Budget & Utilities Review</strong>
          <small>Spreadsheet analysis & recurring savings</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 2: Teams & Startups -->
  <div class="project-showcase-card">
    <div class="project-card-badge">Product Team</div>
    <div class="project-card-header">
      <span class="project-card-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
      </span>
      <div>
        <h3>Q3 Product Launch</h3>
        <span class="project-members-count">8 members · Claude, Gemini & ChatGPT</span>
      </div>
    </div>
    <div class="workstream-sublist">
      <div class="ws-mini-item ws-mini-item--active">
        <span class="ws-mini-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </span>
        <div class="ws-mini-text">
          <strong>Landing Page Copy & Messaging</strong>
          <small>Value pillars, hero headlines, SEO metadata</small>
        </div>
      </div>
      <div class="ws-mini-item">
        <span class="ws-mini-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </span>
        <div class="ws-mini-text">
          <strong>Competitor Feature Matrix</strong>
          <small>Pricing comparison, feature gaps</small>
        </div>
      </div>
      <div class="ws-mini-item">
        <span class="ws-mini-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </span>
        <div class="ws-mini-text">
          <strong>Customer Onboarding Email Sequence</strong>
          <small>Welcome emails, activation tips, survey</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 3: Software & Engineering -->
  <div class="project-showcase-card">
    <div class="project-card-badge">Engineering</div>
    <div class="project-card-header">
      <span class="project-card-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
      </span>
      <div>
        <h3>Core Platform & APIs</h3>
        <span class="project-members-count">6 members · Codex CLI & Cloud Workers</span>
      </div>
    </div>
    <div class="workstream-sublist">
      <div class="ws-mini-item ws-mini-item--active">
        <span class="ws-mini-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </span>
        <div class="ws-mini-text">
          <strong>Realtime Sync & WebSocket Architecture</strong>
          <small>State channels, reconnect backoff, heartbeats</small>
        </div>
      </div>
      <div class="ws-mini-item">
        <span class="ws-mini-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        </span>
        <div class="ws-mini-text">
          <strong>Invitations & Member Role Authorization</strong>
          <small>Workflow: Implement → Test → Security Review</small>
        </div>
      </div>
      <div class="ws-mini-item">
        <span class="ws-mini-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </span>
        <div class="ws-mini-text">
          <strong>End-to-End Test Suite Modernization</strong>
          <small>CI automation, integration runs, mock data</small>
        </div>
      </div>
    </div>
  </div>
</div>
