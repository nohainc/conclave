{
  "activity": {
    "adapter": "agy-stream-json",
    "schemaVersion": 1,
    "mappings": [
      {
        "type": "model.started",
        "status": "running",
        "title": "Thinking",
        "when": [
          {
            "kind": "equals",
            "selector": "$.event",
            "value": "init"
          }
        ]
      },
      {
        "type": "message.updated",
        "status": "updated",
        "title": "Writing the response",
        "when": [
          {
            "kind": "equals",
            "selector": "$.event",
            "value": "step_update"
          },
          {
            "kind": "equals",
            "selector": "$.step_update.step_type",
            "value": "agent_response"
          },
          {
            "kind": "equals",
            "selector": "$.step_update.state",
            "value": "ACTIVE"
          }
        ]
      },
      {
        "type": "tool.started",
        "status": "running",
        "title": "Running a tool",
        "activityIdSelector": "$.step_update.step_index",
        "detailSelectors": {
          "toolName": "$.step_update.tool_name"
        },
        "when": [
          {
            "kind": "equals",
            "selector": "$.event",
            "value": "step_update"
          },
          {
            "kind": "equals",
            "selector": "$.step_update.step_type",
            "value": "tool"
          },
          {
            "kind": "equals",
            "selector": "$.step_update.state",
            "value": "ACTIVE"
          }
        ]
      },
      {
        "type": "tool.completed",
        "status": "completed",
        "title": "Tool completed",
        "activityIdSelector": "$.step_update.step_index",
        "detailSelectors": {
          "toolName": "$.step_update.tool_name"
        },
        "when": [
          {
            "kind": "equals",
            "selector": "$.event",
            "value": "step_update"
          },
          {
            "kind": "equals",
            "selector": "$.step_update.step_type",
            "value": "tool"
          },
          {
            "kind": "equals",
            "selector": "$.step_update.state",
            "value": "DONE"
          },
          {
            "kind": "exists",
            "selector": "$.step_update.tool_info.error",
            "exists": false
          }
        ]
      },
      {
        "type": "tool.failed",
        "status": "failed",
        "title": "Tool failed",
        "activityIdSelector": "$.step_update.step_index",
        "detailSelectors": {
          "toolName": "$.step_update.tool_name"
        },
        "when": [
          {
            "kind": "equals",
            "selector": "$.event",
            "value": "step_update"
          },
          {
            "kind": "equals",
            "selector": "$.step_update.step_type",
            "value": "tool"
          },
          {
            "kind": "equals",
            "selector": "$.step_update.state",
            "value": "DONE"
          },
          {
            "kind": "exists",
            "selector": "$.step_update.tool_info.error",
            "exists": true
          }
        ]
      }
    ]
  },
  "usage": {
    "arguments": ["-p", "/usage"],
    "timeoutMs": 30000
  },
  "compatibilityOverrides": [],
  "engineCompatibility": {
    "maxExclusive": "2.0.0",
    "min": "1.3.0"
  },
  "engineFamily": "cli",
  "environment": {
    "passthrough": [
      "PATH",
      "HOME",
      "USERPROFILE",
      "ProgramFiles",
      "TMP",
      "TEMP",
      "TMPDIR",
      "LANG",
      "LC_ALL",
      "SSL_CERT_FILE",
      "SSL_CERT_DIR",
      "AGY_ADC_AUTH",
      "GEMINI_API_KEY",
      "GOOGLE_API_KEY",
      "GOOGLE_APPLICATION_CREDENTIALS",
      "GOOGLE_CLOUD_PROJECT",
      "GOOGLE_CLOUD_LOCATION",
      "GOOGLE_GEMINI_BASE_URL"
    ],
    "set": {}
  },
  "errors": {
    "mappings": [
      {
        "evidence": {
          "kind": "stderr_pattern",
          "patternId": "model_not_supported"
        },
        "issueCode": "model_not_supported"
      },
      {
        "evidence": {
          "kind": "stderr_pattern",
          "patternId": "session_unavailable"
        },
        "issueCode": "session_resume_failed"
      },
      {
        "evidence": {
          "kind": "stderr_pattern",
          "patternId": "cancelled"
        },
        "issueCode": "cancelled"
      },
      {
        "evidence": {
          "kind": "stderr_pattern",
          "patternId": "deadline_exceeded"
        },
        "issueCode": "deadline_exceeded"
      },
      {
        "evidence": {
          "kind": "stderr_pattern",
          "patternId": "provider_tool_unavailable"
        },
        "issueCode": "provider_tool_unavailable"
      },
      {
        "evidence": {
          "kind": "stderr_pattern",
          "patternId": "provider_authentication_required"
        },
        "issueCode": "provider_authentication_required"
      },
      {
        "evidence": {
          "kind": "stderr_pattern",
          "patternId": "permission_denied"
        },
        "issueCode": "permission_denied"
      },
      {
        "evidence": {
          "kind": "terminal_status",
          "value": "ERROR"
        },
        "issueCode": "provider_failure"
      },
      {
        "evidence": {
          "kind": "missing_terminal"
        },
        "issueCode": "provider_failure"
      }
    ]
  },
  "execution": {
    "arguments": [
      "--disable-slash-commands",
      "--input-format",
      "stream-json",
      "--output-format",
      "stream-json",
      {
        "sandboxPolicyMapping": true
      },
      {
        "providerTimeoutArguments": true
      },
      {
        "sessionResumeArguments": true
      },
      {
        "modelArguments": true
      }
    ],
    "events": [
      {
        "actions": [
          {
            "selector": "$.conversation_id",
            "type": "set_session"
          }
        ],
        "when": [
          {
            "kind": "equals",
            "selector": "$.event",
            "value": "init"
          }
        ]
      },
      {
        "actions": [
          {
            "selector": "$.result.error",
            "type": "set_provider_error"
          },
          {
            "type": "mark_failure"
          }
        ],
        "when": [
          {
            "kind": "equals",
            "selector": "$.event",
            "value": "result"
          },
          {
            "kind": "not_equals",
            "selector": "$.result.status",
            "value": "SUCCESS"
          }
        ]
      },
      {
        "actions": [
          {
            "selector": "$.result.response",
            "type": "set_final_text"
          },
          {
            "type": "mark_success"
          }
        ],
        "when": [
          {
            "kind": "equals",
            "selector": "$.event",
            "value": "result"
          },
          {
            "kind": "equals",
            "selector": "$.result.status",
            "value": "SUCCESS"
          }
        ]
      },
      {
        "actions": [
          {
            "selector": "$.result.conversation_id",
            "type": "set_session"
          },
          {
            "selector": "$.result.status",
            "type": "set_terminal_status"
          }
        ],
        "when": [
          {
            "kind": "equals",
            "selector": "$.event",
            "value": "result"
          }
        ]
      }
    ],
    "output": {
      "mode": "jsonl"
    },
    "stdin": {
      "appendNewline": true,
      "mode": "json_object",
      "value": {
        "event": "user",
        "message": {
          "content": "{{prompt}}"
        }
      }
    }
  },
  "logicalWorkerTypeId": "gemini",
  "model": {
    "arguments": ["--model", "{{model}}"],
    "discovery": {
      "arguments": ["models"],
      "format": "tsv",
      "idPrefix": "",
      "schemaVersion": 1,
      "timeoutMs": 10000,
      "effortVariants": {
        "separator": "-",
        "source": "label_parenthesized_suffix"
      }
    },
    "selectionMode": "combined",
    "supported": true,
    "unknownModelPolicy": "pass_through"
  },
  "probe": {
    "live": {
      "expectedFinalText": {
        "kind": "exact",
        "value": "OK"
      },
      "requiredForReadiness": true,
      "timeoutMs": 30000
    },
    "passive": {
      "checks": [],
      "configChecks": []
    }
  },
  "profileDefinitionId": "gemini-antigravity",
  "progress": [
    {
      "messageKey": "provider_response_received",
      "percentage": 40,
      "when": [
        {
          "kind": "equals",
          "selector": "$.event",
          "value": "step_update"
        },
        {
          "kind": "equals",
          "selector": "$.step_update.state",
          "value": "ACTIVE"
        },
        {
          "kind": "equals",
          "selector": "$.step_update.step_type",
          "value": "agent_response"
        }
      ]
    },
    {
      "messageKey": "provider_working",
      "percentage": 40,
      "when": [
        {
          "kind": "equals",
          "selector": "$.event",
          "value": "step_update"
        },
        {
          "kind": "equals",
          "selector": "$.step_update.state",
          "value": "ACTIVE"
        },
        {
          "kind": "type_is",
          "selector": "$.step_update.step_type",
          "value": "string"
        }
      ]
    }
  ],
  "providerTool": {
    "discovery": {
      "allowPathSearch": true,
      "standardLocations": [
        "{{home}}/.local/bin",
        "{{home}}/.gemini/antigravity-cli/bin"
      ]
    },
    "executableCandidates": ["agy"],
    "name": "Antigravity CLI",
    "supportedVersions": [
      {
        "maxExclusive": "1.2.17",
        "min": "1.2.16"
      },
      {
        "maxExclusive": "1.3.4",
        "min": "1.3.3"
      },
      {
        "min": "1.3.4",
        "maxExclusive": "1.3.6"
      },
      {
        "min": "1.3.6",
        "maxExclusive": "1.4.0"
      },
      {
        "min": "1.4.0",
        "maxExclusive": "1.5.0"
      }
    ],
    "versionProbe": {
      "arguments": ["--version"],
      "extract": {
        "kind": "regex_capture",
        "patternId": "semver"
      },
      "source": "stdout",
      "timeoutMs": 10000
    }
  },
  "releaseVersion": 4,
  "sandbox": {
    "mappings": {
      "full_access": ["--dangerously-skip-permissions"],
      "provider_default": ["--sandbox", "--mode", "plan"],
      "restricted": ["--sandbox", "--mode", "accept-edits"]
    }
  },
  "schemaVersion": 1,
  "session": {
    "compatibleFormatIds": ["antigravity-conversation-v1"],
    "extract": "$.conversation_id",
    "formatId": "antigravity-conversation-v1",
    "requireObservedIdMatch": true,
    "resumeArguments": ["--conversation", "{{sessionId}}"],
    "supported": true
  },
  "timeout": {
    "providerArguments": ["--print-timeout", "{{timeoutSeconds}}s"],
    "providerReserveMs": 1500
  }
}
