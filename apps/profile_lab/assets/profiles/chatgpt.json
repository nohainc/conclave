{
  "activity": {
    "adapter": "codex-jsonl",
    "mappings": [
      {
        "status": "running",
        "title": "Thinking",
        "type": "model.started",
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "turn.started"
          }
        ]
      },
      {
        "status": "updated",
        "title": "Thinking",
        "type": "model.status",
        "when": [
          {
            "kind": "one_of",
            "selector": "$.type",
            "values": ["item.started", "item.updated", "item.completed"]
          },
          {
            "kind": "equals",
            "selector": "$.item.type",
            "value": "reasoning"
          }
        ]
      },
      {
        "activityIdSelector": "$.item.id",
        "detailSelectors": {
          "toolName": "$.item.type"
        },
        "status": "running",
        "title": "Running a command",
        "type": "tool.started",
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "item.started"
          },
          {
            "kind": "equals",
            "selector": "$.item.type",
            "value": "command_execution"
          }
        ]
      },
      {
        "activityIdSelector": "$.item.id",
        "detailSelectors": {
          "toolName": "$.item.type"
        },
        "status": "completed",
        "title": "Command finished",
        "type": "tool.completed",
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "item.completed"
          },
          {
            "kind": "equals",
            "selector": "$.item.type",
            "value": "command_execution"
          }
        ]
      },
      {
        "activityIdSelector": "$.item.id",
        "detailSelectors": {
          "toolName": "$.item.type"
        },
        "status": "running",
        "title": "Using a connected tool",
        "type": "tool.started",
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "item.started"
          },
          {
            "kind": "equals",
            "selector": "$.item.type",
            "value": "mcp_tool_call"
          }
        ]
      },
      {
        "activityIdSelector": "$.item.id",
        "detailSelectors": {
          "toolName": "$.item.type"
        },
        "status": "completed",
        "title": "Connected tool finished",
        "type": "tool.completed",
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "item.completed"
          },
          {
            "kind": "equals",
            "selector": "$.item.type",
            "value": "mcp_tool_call"
          }
        ]
      },
      {
        "activityIdSelector": "$.item.id",
        "detailSelectors": {
          "toolName": "$.item.type"
        },
        "status": "running",
        "title": "Searching the web",
        "type": "tool.started",
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "item.started"
          },
          {
            "kind": "one_of",
            "selector": "$.item.type",
            "values": ["web_search", "web_search_call"]
          }
        ]
      },
      {
        "activityIdSelector": "$.item.id",
        "detailSelectors": {
          "toolName": "$.item.type"
        },
        "status": "completed",
        "title": "Web search finished",
        "type": "tool.completed",
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "item.completed"
          },
          {
            "kind": "one_of",
            "selector": "$.item.type",
            "values": ["web_search", "web_search_call"]
          }
        ]
      },
      {
        "activityIdSelector": "$.item.id",
        "detailSelectors": {
          "toolName": "$.item.type"
        },
        "status": "running",
        "title": "Editing files",
        "type": "tool.started",
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "item.started"
          },
          {
            "kind": "equals",
            "selector": "$.item.type",
            "value": "file_change"
          }
        ]
      },
      {
        "activityIdSelector": "$.item.id",
        "detailSelectors": {
          "toolName": "$.item.type"
        },
        "status": "completed",
        "title": "File edits applied",
        "type": "tool.completed",
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "item.completed"
          },
          {
            "kind": "equals",
            "selector": "$.item.type",
            "value": "file_change"
          }
        ]
      },
      {
        "activityIdSelector": "$.item.id",
        "detailSelectors": {
          "toolName": "$.item.type"
        },
        "status": "running",
        "title": "Working with a sub-agent",
        "type": "tool.started",
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "item.started"
          },
          {
            "kind": "equals",
            "selector": "$.item.type",
            "value": "collab_tool_call"
          }
        ]
      },
      {
        "activityIdSelector": "$.item.id",
        "detailSelectors": {
          "toolName": "$.item.type"
        },
        "status": "completed",
        "title": "Sub-agent finished",
        "type": "tool.completed",
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "item.completed"
          },
          {
            "kind": "equals",
            "selector": "$.item.type",
            "value": "collab_tool_call"
          }
        ]
      },
      {
        "activityIdSelector": "$.item.id",
        "detailSelectors": {
          "toolName": "$.item.type"
        },
        "status": "failed",
        "title": "Tool failed",
        "type": "tool.failed",
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "item.completed"
          },
          {
            "kind": "one_of",
            "selector": "$.item.type",
            "values": [
              "command_execution",
              "mcp_tool_call",
              "file_change",
              "collab_tool_call"
            ]
          },
          {
            "kind": "equals",
            "selector": "$.item.status",
            "value": "failed"
          }
        ]
      },
      {
        "status": "updated",
        "title": "Updating the plan",
        "type": "model.status",
        "when": [
          {
            "kind": "one_of",
            "selector": "$.type",
            "values": ["item.started", "item.updated", "item.completed"]
          },
          {
            "kind": "equals",
            "selector": "$.item.type",
            "value": "todo_list"
          }
        ]
      },
      {
        "status": "updated",
        "title": "Writing the response",
        "type": "message.updated",
        "when": [
          {
            "kind": "one_of",
            "selector": "$.type",
            "values": ["item.started", "item.updated", "item.completed"]
          },
          {
            "kind": "equals",
            "selector": "$.item.type",
            "value": "agent_message"
          }
        ]
      }
    ],
    "schemaVersion": 1
  },
  "usage": {
    "arguments": ["app-server", "--listen", "stdio://"],
    "timeoutMs": 20000,
    "jsonRpc": { "method": "account/rateLimits/read" }
  },
  "compatibilityOverrides": [
    {
      "executionArguments": [
        "exec",
        {
          "sandboxPolicyMapping": true
        },
        {
          "modelArguments": true
        },
        {
          "ifPresent": "reasoningEffort",
          "values": ["-c", "model_reasoning_effort=\"{{reasoningEffort}}\""]
        },
        {
          "sessionResumeArguments": true
        },
        {
          "providerTimeoutArguments": true
        },
        "--json",
        "-"
      ],
      "providerVersion": {
        "maxExclusive": "0.181.0",
        "min": "0.180.0"
      }
    }
  ],
  "engineCompatibility": {
    "maxExclusive": "2.0.0",
    "min": "1.0.0"
  },
  "engineFamily": "cli",
  "environment": {
    "passthrough": [
      "PATH",
      "HOME",
      "USERPROFILE",
      "TMP",
      "TEMP",
      "TMPDIR",
      "LANG",
      "LC_ALL",
      "SSL_CERT_FILE",
      "SSL_CERT_DIR",
      "CODEX_HOME",
      "OPENAI_API_KEY"
    ],
    "set": {
      "NO_COLOR": "1"
    }
  },
  "errors": {
    "mappings": [
      {
        "evidence": {
          "kind": "stderr_pattern",
          "patternId": "session_unavailable"
        },
        "issueCode": "session_resume_failed"
      },
      {
        "evidence": {
          "kind": "stderr_pattern",
          "patternId": "cancelled"
        },
        "issueCode": "cancelled"
      },
      {
        "evidence": {
          "kind": "stderr_pattern",
          "patternId": "deadline_exceeded"
        },
        "issueCode": "deadline_exceeded"
      },
      {
        "evidence": {
          "kind": "stderr_pattern",
          "patternId": "provider_authentication_required"
        },
        "issueCode": "provider_authentication_required"
      },
      {
        "evidence": {
          "kind": "stderr_pattern",
          "patternId": "permission_denied"
        },
        "issueCode": "permission_denied"
      },
      {
        "evidence": {
          "kind": "structured_provider_error",
          "selector": "$.error.message"
        },
        "issueCode": "provider_failure"
      },
      {
        "evidence": {
          "kind": "missing_terminal"
        },
        "issueCode": "provider_failure"
      }
    ]
  },
  "execution": {
    "arguments": [
      {
        "sandboxPolicyMapping": true
      },
      "exec",
      "--json",
      "--color",
      "never",
      "--skip-git-repo-check",
      "--cd",
      "{{workingDirectory}}",
      {
        "modelArguments": true
      },
      {
        "ifPresent": "reasoningEffort",
        "values": ["-c", "model_reasoning_effort=\"{{reasoningEffort}}\""]
      },
      {
        "sessionResumeArguments": true
      },
      {
        "ifAbsent": "sessionId",
        "ifSessionPolicy": "stateless",
        "values": ["--ephemeral"]
      },
      {
        "providerTimeoutArguments": true
      },
      "-"
    ],
    "events": [
      {
        "actions": [
          {
            "selector": "$.thread_id",
            "type": "set_session"
          }
        ],
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "thread.started"
          }
        ]
      },
      {
        "actions": [
          {
            "type": "mark_success"
          }
        ],
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "turn.completed"
          }
        ]
      },
      {
        "actions": [
          {
            "selector": "$.item.text",
            "type": "set_final_text"
          }
        ],
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "item.completed"
          },
          {
            "kind": "equals",
            "selector": "$.item.type",
            "value": "agent_message"
          }
        ]
      },
      {
        "actions": [
          {
            "selector": "$.error.message",
            "type": "set_provider_error"
          },
          {
            "type": "mark_failure"
          }
        ],
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "turn.failed"
          }
        ]
      },
      {
        "actions": [
          {
            "selector": "$.message",
            "type": "set_provider_error"
          },
          {
            "type": "mark_failure"
          }
        ],
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "error"
          }
        ]
      }
    ],
    "output": {
      "mode": "jsonl"
    },
    "stdin": {
      "mode": "raw_text",
      "value": "{{prompt}}"
    }
  },
  "logicalWorkerTypeId": "chatgpt",
  "model": {
    "arguments": ["--model", "{{model}}"],
    "discovery": {
      "arguments": ["app-server", "--listen", "stdio://"],
      "format": "codex_app_server",
      "idPrefix": "",
      "schemaVersion": 1,
      "timeoutMs": 10000
    },
    "supported": true,
    "unknownModelPolicy": "pass_through"
  },
  "probe": {
    "live": {
      "expectedFinalText": {
        "kind": "exact",
        "value": "OK"
      },
      "timeoutMs": 30000
    },
    "passive": {
      "checks": [
        {
          "arguments": ["login", "status"],
          "failureIssueCode": "provider_authentication_required",
          "id": "authentication",
          "successExitCodes": [0],
          "timeoutMs": 10000
        }
      ],
      "configChecks": []
    }
  },
  "profileDefinitionId": "chatgpt-codex",
  "progress": [
    {
      "messageKey": "provider_working",
      "percentage": 10,
      "when": [
        {
          "kind": "equals",
          "selector": "$.type",
          "value": "turn.started"
        }
      ]
    },
    {
      "messageKey": "provider_tool_started",
      "percentage": 45,
      "when": [
        {
          "kind": "one_of",
          "selector": "$.type",
          "values": ["item.started", "item.updated", "item.completed"]
        },
        {
          "kind": "one_of",
          "selector": "$.item.type",
          "values": [
            "command_execution",
            "mcp_tool_call",
            "web_search",
            "web_search_call",
            "file_change",
            "collab_tool_call"
          ]
        }
      ]
    }
  ],
  "providerTool": {
    "discovery": {
      "allowPathSearch": true,
      "standardLocations": ["{{home}}/.local/bin", "/usr/local/bin"]
    },
    "executableCandidates": ["codex"],
    "name": "Codex CLI",
    "supportedVersions": [
      {
        "maxExclusive": "0.190.0",
        "min": "0.158.0"
      }
    ],
    "versionProbe": {
      "arguments": ["--version"],
      "extract": {
        "kind": "regex_capture",
        "patternId": "semver"
      },
      "source": "stdout",
      "timeoutMs": 10000
    }
  },
  "releaseVersion": 2,
  "sandbox": {
    "mappings": {
      "full_access": ["--dangerously-bypass-approvals-and-sandbox"],
      "provider_default": [
        "--ask-for-approval",
        "never",
        "--sandbox",
        "read-only"
      ],
      "restricted": [
        "--ask-for-approval",
        "never",
        "--sandbox",
        "workspace-write"
      ]
    }
  },
  "schemaVersion": 1,
  "session": {
    "compatibleFormatIds": ["codex-thread-v1"],
    "extract": "$.thread_id",
    "formatId": "codex-thread-v1",
    "requireObservedIdMatch": true,
    "resumeArguments": ["resume", "{{sessionId}}"],
    "supported": true
  },
  "timeout": {
    "providerArguments": [],
    "providerReserveMs": 2000
  }
}
