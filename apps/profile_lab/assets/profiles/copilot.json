{
  "schemaVersion": 1,
  "profileDefinitionId": "copilot-cli",
  "releaseVersion": 10,
  "logicalWorkerTypeId": "copilot",
  "engineFamily": "cli",
  "engineCompatibility": {
    "min": "1.0.0",
    "maxExclusive": "2.0.0"
  },
  "providerTool": {
    "name": "GitHub Copilot CLI",
    "executableCandidates": [
      "copilot"
    ],
    "discovery": {
      "standardLocations": [
        "{{home}}/.local/bin",
        "/usr/local/bin"
      ],
      "allowPathSearch": true
    },
    "versionProbe": {
      "arguments": [
        "--version"
      ],
      "timeoutMs": 10000,
      "source": "stdout",
      "extract": {
        "kind": "regex_capture",
        "patternId": "semver"
      }
    }
  },
  "environment": {
    "passthrough": [
      "PATH",
      "HOME",
      "USER",
      "LOGNAME",
      "SHELL",
      "__CF_USER_TEXT_ENCODING",
      "USERPROFILE",
      "TMP",
      "TEMP",
      "TMPDIR",
      "LANG",
      "LC_ALL",
      "SSL_CERT_FILE",
      "SSL_CERT_DIR",
      "XDG_CONFIG_HOME",
      "COPILOT_HOME",
      "COPILOT_GITHUB_TOKEN",
      "GH_TOKEN",
      "GITHUB_TOKEN"
    ],
    "set": {
      "NO_COLOR": "1"
    }
  },
  "probe": {
    "passive": {
      "checks": [],
      "configChecks": []
    }
  },
  "execution": {
    "arguments": [
      {
        "sandboxPolicyMapping": true
      },
      "--no-color",
      "--output-format",
      "json",
      "--stream",
      "off",
      {
        "modelArguments": true
      },
      {
        "ifPresent": "reasoningEffort",
        "values": [
          "--reasoning-effort",
          "{{reasoningEffort}}"
        ]
      },
      {
        "sessionResumeArguments": true
      },
      {
        "providerTimeoutArguments": true
      }
    ],
    "stdin": {
      "mode": "raw_text",
      "value": "{{prompt}}"
    },
    "output": {
      "mode": "jsonl"
    },
    "events": [
      {
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "assistant.message"
          }
        ],
        "actions": [
          {
            "type": "set_final_text",
            "selector": "$.data.content"
          }
        ]
      },
      {
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "session.error"
          }
        ],
        "actions": [
          {
            "type": "set_provider_error",
            "selector": "$.data.message"
          },
          {
            "type": "mark_failure"
          }
        ]
      },
      {
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "result"
          },
          {
            "kind": "equals",
            "selector": "$.exitCode",
            "value": 0
          }
        ],
        "actions": [
          {
            "type": "set_session",
            "selector": "$.sessionId"
          },
          {
            "type": "mark_success"
          }
        ]
      },
      {
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "result"
          },
          {
            "kind": "not_equals",
            "selector": "$.exitCode",
            "value": 0
          }
        ],
        "actions": [
          {
            "type": "set_session",
            "selector": "$.sessionId"
          },
          {
            "type": "mark_failure"
          }
        ]
      }
    ]
  },
  "model": {
    "supported": true,
    "arguments": [
      "--model",
      "{{model}}"
    ],
    "unknownModelPolicy": "pass_through",
    "discovery": {
      "schemaVersion": 1,
      "arguments": [
        "--headless",
        "--stdio"
      ],
      "timeoutMs": 10000,
      "format": "copilot_sdk_rpc",
      "idPrefix": ""
    }
  },
  "progress": [
    {
      "messageKey": "provider_working",
      "percentage": 10,
      "when": [
        {
          "kind": "equals",
          "selector": "$.type",
          "value": "assistant.turn_start"
        }
      ]
    },
    {
      "messageKey": "provider_response_received",
      "percentage": 60,
      "when": [
        {
          "kind": "equals",
          "selector": "$.type",
          "value": "assistant.message"
        }
      ]
    }
  ],
  "activity": {
    "schemaVersion": 1,
    "mappings": [
      {
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "assistant.turn_start"
          }
        ],
        "type": "model.started",
        "status": "running",
        "title": "Thinking"
      },
      {
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "tool.execution_start"
          }
        ],
        "type": "tool.started",
        "status": "running",
        "title": "Using a tool",
        "activityIdSelector": "$.data.toolCallId",
        "detailSelectors": {
          "toolName": "$.data.toolName"
        }
      },
      {
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "tool.execution_complete"
          },
          {
            "kind": "equals",
            "selector": "$.data.success",
            "value": true
          }
        ],
        "type": "tool.completed",
        "status": "completed",
        "title": "Tool finished",
        "activityIdSelector": "$.data.toolCallId"
      },
      {
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "tool.execution_complete"
          },
          {
            "kind": "equals",
            "selector": "$.data.success",
            "value": false
          }
        ],
        "type": "tool.failed",
        "status": "failed",
        "title": "Tool failed",
        "activityIdSelector": "$.data.toolCallId"
      },
      {
        "when": [
          {
            "kind": "equals",
            "selector": "$.type",
            "value": "assistant.message"
          },
          {
            "kind": "exists",
            "selector": "$.data.content",
            "exists": true
          }
        ],
        "type": "message.updated",
        "status": "updated",
        "title": "Writing the response"
      }
    ]
  },
  "errors": {
    "mappings": [
      {
        "evidence": {
          "kind": "stderr_pattern",
          "patternId": "cancelled"
        },
        "issueCode": "cancelled"
      },
      {
        "evidence": {
          "kind": "stderr_pattern",
          "patternId": "deadline_exceeded"
        },
        "issueCode": "deadline_exceeded"
      },
      {
        "evidence": {
          "kind": "stderr_pattern",
          "patternId": "provider_tool_unavailable"
        },
        "issueCode": "provider_tool_unavailable"
      },
      {
        "evidence": {
          "kind": "stderr_pattern",
          "patternId": "provider_authentication_required"
        },
        "issueCode": "provider_authentication_required"
      },
      {
        "evidence": {
          "kind": "stderr_pattern",
          "patternId": "model_not_supported"
        },
        "issueCode": "model_not_supported"
      },
      {
        "evidence": {
          "kind": "stderr_pattern",
          "patternId": "quota_exhausted"
        },
        "issueCode": "quota_exhausted"
      },
      {
        "evidence": {
          "kind": "stderr_pattern",
          "patternId": "permission_denied"
        },
        "issueCode": "permission_denied"
      },
      {
        "evidence": {
          "kind": "missing_terminal"
        },
        "issueCode": "provider_failure"
      }
    ]
  },
  "sandbox": {
    "mappings": {
      "restricted": [
        "--allow-tool",
        "write",
        "--deny-tool",
        "shell"
      ],
      "provider_default": [],
      "full_access": [
        "--allow-all"
      ]
    }
  },
  "session": {
    "supported": true,
    "formatId": "copilot-session-v1",
    "compatibleFormatIds": [
      "copilot-session-v1"
    ],
    "extract": "$.sessionId",
    "resumeArguments": [
      "--session-id",
      "{{sessionId}}"
    ],
    "requireObservedIdMatch": true
  },
  "timeout": {
    "providerArguments": [],
    "providerReserveMs": 2000
  },
  "compatibilityOverrides": [],
  "usage": {
    "arguments": [
      "--headless",
      "--stdio"
    ],
    "timeoutMs": 20000,
    "jsonRpc": {
      "method": "account.getQuota",
      "framing": "content_length"
    }
  }
}
